config ARCH_ARM
   bool

rsource "arm/Kconfig"

rsource "arm64/Kconfig"

config ARCH_CSKY
   bool

config ARCH_RISCV
   bool

config ARCH_RISCV32
   bool
   select ARCH_RISCV

config ARCH_CACHE
    bool "Enable arch cache maintenance API (ArchICache*/ArchDCache*)"
    depends on ARCH_RISCV
    default n
    help
      Build in the RISC-V I/D-cache maintenance interface (arch/cache.h) and
      its open-source per-core implementation (e.g. ws63 builds
      arch/risc-v/src/linx131/los_cache.c for LinxCore131). Each board that
      turns this on must supply a cache implementation matching its ABI and
      core CSR space (e.g. ws63 builds los_cache.c for the LinxCore131 custom
      CSR space 0x7C0..0x7C7; DiTing/3322 needs its own implementation for
      Linx-M with ilp32d). Boards without a cache provider must leave this
      off so the ArchICache*/ArchDCache* symbols are not referenced.

config ARCH_RISCV_HW_ATOMIC
    bool "RISC-V hardware Atomic (A) extension is available"
    depends on ARCH_RISCV
    default n
    help
      Select this if the RISC-V core implements the standard Atomic (A)
      extension in hardware (lr.w/sc.w/amoadd.w/amoswap.w ...). When
      selected, the arch atomic operations use A-extension instructions;
      otherwise they fall back to interrupt-lock (LOS_IntLock) based
      atomics, which is correct for single-core but disables interrupts
      during each operation.

config ARCH_XTENSA
   bool

rsource "risc-v/Kconfig"

comment "Extra Configurations"

config ARCH_FPU_DISABLE
    bool "Disable Floating Pointer Unit"
    default n
    help
      This option will bypass floating procedure in system.

config ARCH_FPU_DOUBLE
    bool "Enable Double Precision FPU (D extension)"
    default n
    depends on !ARCH_FPU_DISABLE
    help
      Save/restore FP registers as 64-bit slots (fld/fsd, FPUREGBYTES=8) and
      build with the D extension under the hard-float ilp32d ABI. The board config.gni must
      use -march with the d extension and -mabi=ilp32d when this is set.

config ARCH_UNALIGNED_EXC
    bool "Enable Unaligned Exception"
    default y
    depends on ARCH_ARM
    help
     This option will enable unaligned exception.

config EXC_SIMPLE_INFO
    bool "Enable Exception Simple Info"
    default n
    help
      This option is used to reduce exc output info.

config ARCH_TIMER_VENDOR
    bool "Use vendor-provided timer instead of arch default"
    default n
    help
      Select this if the board has a custom timer (not SiFive CLINT).
      The board must provide its own ArchSysTickTimerGet() and ArchEnterSleep().

