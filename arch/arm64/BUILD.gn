# AArch64 (ARMv8-A EL1) architecture layer for liteos_m.
# Ported from hs-fbb arch_lite/arm64; interrupt dispatch table helpers
# (los_common_interrupt.c) are built as part of this module.

import("//kernel/liteos_m/liteos.gni")

module_name = "arm64"
kernel_module(module_name) {
  sources = [
    "los_cache.S",
    "los_context.c",
    "los_cpu.c",
    "los_dispatch.S",
    "los_el_switch.S",
    "los_exc.S",
    "los_fault.c",
    "los_common_interrupt.c",
    "los_mmu.c",
    "los_timer.c",
  ]
  configs += [ "$LITEOSTOPDIR:warn_config" ]
}

config("public") {
  include_dirs = [ "." ]
}
