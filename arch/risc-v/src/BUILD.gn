# Kernel -march/-mabi are composed from the Kconfig ISA capability symbols
# (ARCH_RISCV_ISA_*/RV32IMC/LINX_M, Linux riscv-march-y model) and emitted
# from :public, which lands after the board-owned -march (last one wins):
# qemu rv32imac, ws63 rv32imfc, hi3322 rv32imfdcb0p92xlinxma_xlinxmb_xlinxmc_xlinxmd.

import("../../../liteos.gni")

RISCV_MARCH = ""
RISCV_MABI = ""
if (defined(LOSCFG_ARCH_RISCV32)) {
  RISCV_MARCH = "rv32im"
  RISCV_MABI = "ilp32"
  if (defined(LOSCFG_ARCH_RISCV_ISA_A)) {
    RISCV_MARCH += "a"
  }
  if (defined(LOSCFG_ARCH_RISCV_ISA_F)) {
    RISCV_MARCH += "f"
    RISCV_MABI = "ilp32f"
  }
  if (defined(LOSCFG_ARCH_RISCV_ISA_D)) {
    RISCV_MARCH += "d"
    RISCV_MABI = "ilp32d"
  }
  if (defined(LOSCFG_ARCH_RISCV_RV32IMC)) {
    RISCV_MARCH += "c"
  }

  # clang 15+ bare "b" means ratified B 1.0; LinxCore170 has the 0.92 draft only.
  if (defined(LOSCFG_ARCH_RISCV_ISA_B0p92)) {
    RISCV_MARCH += "b0p92"
  } else if (defined(LOSCFG_ARCH_RISCV_ISA_B1p0)) {
    RISCV_MARCH += "b"
  }

  if (defined(LOSCFG_ARCH_LINX_M)) {
    # m-profile full custom segment set; LCMP_* per-segment symbols stay
    # separate (they gate instruction EMITTING, see los_dispatch.S).
    RISCV_MARCH += "xlinxma_xlinxmb_xlinxmc_xlinxmd"
  } else {
    # Standalone LCMP segments: each LCMP_* symbol adds its own segment.
    _xlinx = ""
    if (defined(LOSCFG_LCMP_CUSTOM_INST16_EXTENSIONS)) {
      _xlinx += "xlinxma"
    }
    if (defined(LOSCFG_LCMP_CUSTOM_INST16_SUB_EXTENSIONS)) {
      if (_xlinx != "") {
        _xlinx += "_"
      }
      _xlinx += "xlinxmb"
    }
    if (defined(LOSCFG_LCMP_CUSTOM_INST32_EXTENSIONS)) {
      if (_xlinx != "") {
        _xlinx += "_"
      }
      _xlinx += "xlinxmc"
    }
    if (defined(LOSCFG_LCMP_CUSTOM_INST48_EXTENSIONS)) {
      if (_xlinx != "") {
        _xlinx += "_"
      }
      _xlinx += "xlinxmd"
    }
    if (_xlinx != "") {
      RISCV_MARCH += _xlinx
    }
  }
}

kernel_module("arch") {
  sources = [
    "los_context.c",
    "los_dispatch.S",
    "los_exc.S",
    "los_interrupt.c",
    "los_trap.S",
  ]
  if (!defined(LOSCFG_ARCH_TIMER_VENDOR)) {
    sources += [ "los_timer.c" ]
  }

  # Arch-level reset entry + stack allocation (excluded when board supplies its own).
  if (!defined(LOSCFG_USING_BOARD_RESET_VECTOR)) {
    sources += [
      "los_reset_vector.S",
      "los_stack.S",
    ]
  }

  # Core-specific trap replacement: LinxCore131 has its own trap entry
  # with hardware interrupt nesting (0xBFE/0x7ED CSR), replacing the
  # default los_trap.S.
  if (defined(LOSCFG_ARCH_LINXCORE_131)) {
    sources -= [ "los_trap.S" ]
    sources += [ "linx131/trap.S" ]
  }

  # Cache maintenance: unified for LinxCore131/170. Differences are handled
  # via LOSCFG_ARCH_LINX_M (#ifdef in los_cache.c). Gated by LOSCFG_ARCH_CACHE.
  if (defined(LOSCFG_ARCH_CACHE)) {
    sources += [ "los_cache.c" ]
  }
  configs += [ "$LITEOSTOPDIR:warn_config" ]
}

config("public") {
  include_dirs = [
    ".",
    "../include",
    "../include/arch",
  ]

  # Kconfig-composed ISA, emitted here so it lands after the board-owned
  # -march (last one wins).
  if (RISCV_MARCH != "") {
    cflags = [
      "-march=$RISCV_MARCH",
      "-mabi=$RISCV_MABI",
    ]
    cflags_cc = cflags
    asmflags = cflags
  }
}
