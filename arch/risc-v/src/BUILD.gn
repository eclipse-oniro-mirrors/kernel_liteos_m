# -march/-mabi are owned by the board-level config.gni (OHOS convention,
# e.g. ws63: rv32imfc / ilp32f); the arch module must not inject them.

import("../../../liteos.gni")

kernel_module("arch") {
  sources = [
    "los_context.c",
    "los_dispatch.S",
    "los_exc.S",
    "los_interrupt.c",
    "los_trap.S",
  ]
  if (!defined(LOSCFG_ARCH_TIMER_VENDOR)) {
    sources += [ "los_timer.c" ]
  }

  # Arch-level reset entry + stack allocation (excluded when board supplies its own).
  if (!defined(LOSCFG_USING_BOARD_RESET_VECTOR)) {
    sources += [
      "los_reset_vector.S",
      "los_stack.S",
    ]
  }

  # Core-specific trap replacement: LinxCore131 has its own trap entry
  # with hardware interrupt nesting (0xBFE/0x7ED CSR), replacing the
  # default los_trap.S.
  if (defined(LOSCFG_ARCH_LINXCORE_131)) {
    sources -= [ "los_trap.S" ]
    sources += [ "linx131/trap.S" ]
  }

  # Cache maintenance: per-core implementation to accommodate interface
  # differences (131 vs 170 have different symbol sets, Enable branches,
  # CSR layouts). Gated by LOSCFG_ARCH_CACHE.
  if (defined(LOSCFG_ARCH_CACHE)) {
    if (defined(LOSCFG_ARCH_LINXCORE_131)) {
      sources += [ "linx131/los_cache.c" ]
    } else if (defined(LOSCFG_ARCH_LINXCORE_170)) {
      # sources += [ "linx170/los_cache.c" ]  # TODO: 3322/DiTing cache
    }
  }
  configs += [ "$LITEOSTOPDIR:warn_config" ]
}

config("public") {
  include_dirs = [
    ".",
    "../include",
    "../include/arch",
  ]
}
