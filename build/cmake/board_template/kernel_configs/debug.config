# board template —— 最小 LOSCFG_* Kconfig 片段。
# 复制本文件并开启你的板需要的特性。这里的每行 LOSCFG_* 都是注释掉的起点；
# 取消注释以启用。
#
# 本文件结构镜像 3322 参考（见 vendor/hispark_hiditing/kernel_configs/debug.config）。
# 你的 board 的 .config 被以下消费：
#   - GN genconfig（→ menuconfig.snapshot.h，经 export_cmake_sources.py）
#   - sources.cmake 模块守护（LOSCFG_* 开关决定模块源码组开/关）
#
# ⚠ 注意：CMake 源码级集成路径（liteos_m/CMakeLists.txt）**不读取**本文件——
# 它只服务于 GN 重新导出快照的维护者流程。日常功能开关请改
# include/target_config.h（gate sync 会自动跟随），
# 见 docs/integration-guide.md "功能开关：target_config.h 是唯一事实源"。

# --- 平台 / 架构（替换为你的 SoC + 架构）---
# LOSCFG_PLATFORM_<YOUR_SOC>=y
# LOSCFG_ARCH_RISCV=y
# LOSCFG_ARCH_RISCV32=y
# LOSCFG_ARCH_RISCV_RV32IMC=y
# LOSCFG_COMPILER_CLANG_LLVM=y

# --- FPU（硬件浮点时开启；与 CCFLAGS 中的 -march *d 配对）---
# LOSCFG_ARCH_FPU_DOUBLE=y

# --- 定时器（二选一；非标准硬件用厂商定时器）---
# LOSCFG_ARCH_TIMER_VENDOR=y
# LOSCFG_KERNEL_TICK_PERIODIC=y

# --- 内核核心 ---
LOSCFG_BASE_IPC_SEM=y
LOSCFG_BASE_IPC_SEM_LIMIT=32
LOSCFG_BASE_IPC_MUX=y
LOSCFG_BASE_IPC_MUX_LIMIT=60
LOSCFG_BASE_IPC_QUEUE=y
LOSCFG_BASE_IPC_QUEUE_LIMIT=30

# --- 内存（bestfit 是常用分配器）---
LOSCFG_KERNEL_MEM_BESTFIT=y
LOSCFG_MEM_MUL_MODULE=y

# --- CPUP / 回溯（可选，调试时有用）---
# LOSCFG_KERNEL_CPUP=y
# LOSCFG_KERNEL_BACKTRACE=y

# --- 关键时序/容量值（必须与 target_config.h 一致；见 CMakeLists.txt 的
#     分叉守护——EVOLVE_DIVERGE_GUARD 默认检查这 5 个）---
# LOSCFG_BASE_CORE_TICK_PER_SECOND=1000
# LOSCFG_BASE_CORE_TIMESLICE_TIMEOUT=2000
# LOSCFG_HWI_PRIO_LIMIT=7
# LOSCFG_CPUP_SAMPLE_PERIOD=10000
# LOSCFG_BASE_IPC_QUEUE_LIMIT=64

# --- 任务限额（按你的 RAM 调整）---
LOSCFG_BASE_CORE_TSK_LIMIT=28
LOSCFG_BASE_CORE_TSK_MIN_STACK_SIZE=1024
LOSCFG_BASE_CORE_TSK_IDLE_STACK_SIZE=2048
LOSCFG_BASE_CORE_SWTMR_LIMIT=16
