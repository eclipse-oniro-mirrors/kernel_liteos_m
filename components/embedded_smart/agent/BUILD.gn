import("//build/lite/config/component/lite_component.gni")

static_library("libagent") {
  sources = [
    "src/kernel/kernel.c",
    "src/kernel/llm.c",
    "src/kernel/skill.c",
    "src/kernel/working_memory.c",
    "src/runtime/runtime.c",
    "src/runtime/builtin_tools.c",
    "src/runtime/robot_tools.c",
    "src/session/session.c",
    "src/hub/hub.c",
    "src/config/config.c",
    "src/memory/memory.c",
    "src/observability/observability.c",
    "src/util/json.c",
    "agent_core.c",
  ]
  include_dirs = [
    ".",
    "include",
    "include/agent",
    "include/litecrab",
    # llm_stream 必须排在 network 之前: 两处都有 llm_client.h(同名),
    # 流式分支(llm_chat_stream_raw, v1.4)只在 llm_stream 包里有声明。
    "//kernel/liteos_m/components/embedded_smart/applications/agent_test/llm_stream",
    "//device/soc/hisilicon/common/platform/network",
  ]
  cflags = [
    "-include",
    rebase_path("platform_3516.h"),
    "-D_GNU_SOURCE",
    "-Wno-unused-parameter",
    "-Wno-unused-variable",
    "-Wno-unused-function",
  ]
  deps = [
    "//third_party/mbedtls:mbedtls_shared",
    # LLM 客户端改链包内源码版(v1.4, 含 llm_chat_stream_raw — agent 流式用):
    # 原 network/libllmclient.a(v1.1, 无流式) 不再引用。见 SPEC_VOICE_AGENT.md §16。
    "//kernel/liteos_m/components/embedded_smart/applications/agent_test/llm_stream:llmclient_stream",
  ]
}

# 输出改名 agent_demo: agent_test 名字让给 embedded_smart 综合控制台
# (//kernel/liteos_m/.../agent_test/app_test:agent_test, 同产 bin/agent_test,
#  GN 会报 duplicate output)。本程序是 libagent 库级冒烟测试 CLI。
executable("agent_test") {
  output_name = "agent_demo"
  sources = [ "agent_test.c" ]
  include_dirs = [ "include" ]
  deps = [
    ":libagent",
    "//third_party/mbedtls:mbedtls_shared",
  ]
}

group("agent_group") {
  deps = [
    ":libagent",
    ":agent_test",
  ]
}

lite_component("agent") {
  features = [ ":agent_group" ]
}
