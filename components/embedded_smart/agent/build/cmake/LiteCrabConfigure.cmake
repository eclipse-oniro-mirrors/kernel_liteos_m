find_package(Python3 REQUIRED COMPONENTS Interpreter)

set(LITECRAB_PROFILE "diagnostic_sd5091" CACHE STRING "LiteCrab product profile")
set(LITECRAB_GENERATED_DIR
    "${CMAKE_CURRENT_BINARY_DIR}/generated/${LITECRAB_PROFILE}"
    CACHE PATH "LiteCrab generated configuration directory")
set(LITECRAB_CONFIG_FRAGMENT "" CACHE FILEPATH "Optional test-only Kconfig fragment")

set(LITECRAB_CONFIGURE_FRAGMENT_ARGS)
if(LITECRAB_CONFIG_FRAGMENT)
  list(APPEND LITECRAB_CONFIGURE_FRAGMENT_ARGS --fragment "${LITECRAB_CONFIG_FRAGMENT}")
endif()

execute_process(
  COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/kconfig/configure.py"
          --profile "${LITECRAB_PROFILE}"
          --output-dir "${LITECRAB_GENERATED_DIR}"
          --repo-root "${CMAKE_CURRENT_SOURCE_DIR}"
          ${LITECRAB_CONFIGURE_FRAGMENT_ARGS}
  WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
  RESULT_VARIABLE LITECRAB_CONFIGURE_RESULT
  OUTPUT_VARIABLE LITECRAB_CONFIGURE_OUTPUT
  ERROR_VARIABLE LITECRAB_CONFIGURE_ERROR)
if(NOT LITECRAB_CONFIGURE_RESULT EQUAL 0)
  message(FATAL_ERROR
    "LiteCrab profile generation failed (${LITECRAB_CONFIGURE_RESULT}):\n"
    "${LITECRAB_CONFIGURE_OUTPUT}${LITECRAB_CONFIGURE_ERROR}")
endif()
message(STATUS "${LITECRAB_CONFIGURE_OUTPUT}")
include("${LITECRAB_GENERATED_DIR}/litecrab_sources.cmake")
