{
  "server": {
    "listen_ip": "127.0.0.1",
    "listen_port": 10003,
    "worker_threads": 4,
    "max_connections": 16
  },
  "log": {
    "dir": "logs"
  },
  "workspace_root": ".",
  "mcp": {
    "enabled": true,
    "required": true,
    "connect_timeout_ms": 1000,
    "request_timeout_ms": 3000,
    "limits": {
      "max_message_bytes": 262144
    },
    "devices": [
      {
        "id": "local-device",
        "alias": "lab",
        "enabled": true,
        "required": true,
        "transport": "streamable-http",
        "url": "http://127.0.0.1:18081/mcp"
      }
    ]
  }
}