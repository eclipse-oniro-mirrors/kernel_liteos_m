{
  "server": {
    "listen_ip": "127.0.0.1",
    "allow_unauthenticated_remote": false,
    "listen_port": 10003,
    "backlog": 32,
    "recv_timeout_ms": 300000,
    "send_timeout_ms": 300000,
    "max_req_bytes": 16384,
    "worker_threads": 4,
    "max_connections": 16
  },
  "log": {
    "dir": "logs",
    "level": "INFO"
  },
  "workspace_root": ".",
  "memory": {
    "enabled": false,
    "store_dir": ".crab/memory",
    "summary_max_bytes": 2048,
    "recent_max_bytes": 65536,
    "recent_context_items": 8,
    "max_context_bytes": 4096,
    "sync_writes": true
  },
  "mcp": {
    "enabled": false,
    "required": false,
    "connect_timeout_ms": 3000,
    "request_timeout_ms": 10000,
    "limits": {
      "max_message_bytes": 262144
    },
    "devices": [
      {
        "id": "device-01",
        "alias": "power_room_1",
        "enabled": true,
        "required": false,
        "transport": "streamable-http",
        "url": "https://192.168.8.10:18443/mcp",
        "ca_file": "./config/certs/ca-bundle.crt",
        "token_env": "LITECRAB_DEVICE_01_MCP_TOKEN"
      }
    ]
  }
}
