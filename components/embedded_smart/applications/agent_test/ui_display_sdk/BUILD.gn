import("//build/lite/config/component/lite_component.gni")

# ui_display 配套屏 UI(表情 GIF)集成文件(源码树 applications/ui_display_sdk)
#
# 来源: 交付包_UIDISPLAY_v1/SDK库包(源码+assets 全量拷贝), 在包版基础上增加:
#   - 板上实体按键接管表情切换: key1(GPIO0_2)=上一个表情, key2(GPIO0_1)=下一个表情,
#     所有表情循环(SetEmotionByIndex 自带回绕)。
#     dep applications/agent_test/key_sdk 源码直编的 keydriver 库;
#     GPIO 事件只能被一个进程消费,
#     app_test 的 KeySvcStart() 已停用自启(见 app_test/main/app_test.c)。
#
# 表情资产经 emoji_assets copy 目标打进 userfs data/emoji/(板上 /storage/data/emoji);
# 字体/断行规则由 ui_lite 自带 BUILD.gn 打包(无需处理)。

_hdf_include = [
  "//drivers/hdf_core/framework/include/core",
  "//drivers/hdf_core/framework/include/osal",
  "//drivers/hdf_core/framework/include/platform",
  "//drivers/hdf_core/framework/include/utils",
  "//drivers/hdf_core/interfaces/inner_api/core",
  "//drivers/hdf_core/interfaces/inner_api/osal/shared",
  "//drivers/hdf_core/interfaces/inner_api/osal/uhdf",
  "//drivers/hdf_core/interfaces/inner_api/utils",
]

executable("ui_display") {
  sources = [
    "emoji_display.cpp",
    "gif_decoder.c",
    "ui_design.cpp",
    "ui_display.cpp",
  ]

  include_dirs = [
    "//foundation/arkui/ui_lite/frameworks",
    # key_driver.h 在本包 key_sdk(原 //applications/key_sdk 壳仅存 bundle.json)
    "//kernel/liteos_m/components/embedded_smart/applications/agent_test/key_sdk",
  ] + _hdf_include

  ldflags = [
    "-lstdc++",
    "-lpthread",
    "-Wl,-rpath-link=$ohos_root_path/$root_out_dir",
  ]

  deps = [
    "//foundation/arkui/ui_lite:ui_lite",
    "//foundation/graphic/graphic_utils_lite:lite_graphic_hals",
    "//foundation/window/window_manager_lite:wms_client",
    "//third_party/freetype:freetype",
    # key_sdk 源码直编库(替代预编译 libkeydriver.a)
    "//kernel/liteos_m/components/embedded_smart/applications/agent_test/key_sdk:keydriver",
    # key_sdk 用户态 HDI 实现(板上 /usr/lib/libhdf_platform.so)
    "//drivers/hdf_core/adapter/uhdf/platform:hdf_platform",
    ":emoji_assets",
    ":bg_assets",
  ]
}

# 全屏背景 PNG + WiFi 月亮图标打包进 userfs data/bg/(板上路径 /storage/data/bg/)
# 资源源文件放 vendor/hisilicon/hispark_taurus/data/background/(资产随产品走)
copy("bg_assets") {
  sources = [
    "//vendor/hisilicon/hispark_taurus/data/background/background.png",
    "//vendor/hisilicon/hispark_taurus/data/background/wifi_connect.png",
  ]
  outputs = [ "$root_out_dir/data/bg/{{source_file_part}}" ]
}

# 表情资产打包进 userfs data/emoji/(板上路径 /storage/data/emoji)
# 资源头文件放 vendor/hisilicon/hispark_taurus/data/emoji/(资产随产品走,同 bg_assets)
copy("emoji_assets") {
  sources = [
    "//vendor/hisilicon/hispark_taurus/data/emoji/angry.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/confident.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/confused.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/cool.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/crying.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/delicious.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/embarrassed.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/funny.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/happy.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/kissy.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/laughing.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/loving.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/neutral.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/relaxed.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/sad.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/shocked.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/silly.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/sleepy.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/surprised.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/thinking.gif",
    "//vendor/hisilicon/hispark_taurus/data/emoji/winking.gif",
  ]
  outputs = [ "$root_out_dir/data/emoji/{{source_file_part}}" ]
}

group("ui_display_group") {
  deps = [ ":ui_display" ]
}

lite_component("ui_display_sdk") {
  features = [ ":ui_display" ]
}
