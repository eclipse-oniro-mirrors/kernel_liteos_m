# Shared plumbing for the generated libmetal/libmica include sets.
#
# This tree's gn binary has no glob(), and exec_script() is blocked by the
# build's exec_script allowlist (the CI gate runs a pristine build repo, so
# an allowlist entry there is not an option). The header input list is
# therefore maintained as a STATIC list below: it is the exact output of
#     gen_mcs_includes.py --list <same mcs_gen_args as below>
# and must be regenerated (paste the // form of the paths) whenever the
# prebuilt libmetal headers (SoC repo) or the compat/mcs mica/backend
# headers (kernel repo) change.

mcs_gen_args = [
  "--metal-lib",
  rebase_path("//device/soc/rockchip/rk3568_m/include/libmetal", ""),
  "--metal-backend",
  rebase_path("//device/soc/rockchip/rk3568_m/include/libmetal/system/liteos", ""),
  "--mica-lib",
  rebase_path("//kernel/liteos_m/compat/mcs/mica/libmica/lib", ""),
  "--mica-platform",
  rebase_path("//kernel/liteos_m/compat/mcs/mica/platform", ""),
]

