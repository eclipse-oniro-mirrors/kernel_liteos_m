# Interrupt controller drivers.
# Controllers are promptless — they are selected by the core select
# chain (e.g. ARCH_LINXCORE_131 selects RISCV_HIMIDEERV200_PLIC) or
# directly by a board's platform select in the top-level Kconfig;
# never set from a kernel config line. ARCH_INTERRUPT_VENDOR is the
# escape hatch: when a board sets it, core-level auto-select is
# skipped and the board must either select an in-tree controller from
# its platform Kconfig or provide its own controller driver in board
# code. Only the selected driver source is compiled (see BUILD.gn).
# One controller per platform — co-selection is a duplicate-symbol
# link error (each driver defines its own g_hwiControllerOps +
# HwiControllerOpsGet).

config ARCH_INTERRUPT_VENDOR
    bool "Use vendor-provided interrupt controller (skip core auto-select)"
    depends on ARCH_RISCV
    help
      Platform takes over interrupt controller driver selection.
      When set, core-level auto-select of interrupt controllers is
      skipped (the "if !ARCH_INTERRUPT_VENDOR" guard on core select
      lines), and the board must select an in-tree controller from
      its platform Kconfig or provide its own controller driver in
      board code. Reserved for platforms that use a fully
      vendor-specific interrupt controller not covered by the core
      select chain.

config RISCV_LCMP_CLIC
    bool
    depends on ARCH_LINX_M
    select ARCH_INTERRUPT_TAKEOVER
    help
      RISC-V Core-Local Interrupt Controller (CLIC) for LinxCore.
      Used by HI3322. Does not auto-clear pending bits (unlike PLIC).

config RISCV_HIMIDEERV200_PLIC
    bool
    depends on ARCH_LINXCORE_131
    select ARCH_INTERRUPT_TAKEOVER
    help
      HiSilicon himideerv200 Platform Level Interrupt Controller for
      WS63 (riscv31 core). CSR-based (no memory map): vectors 0..31
      via mie/mip, 32..95 via LOCIEN0/1. Source replacement for the
      prebuilt libinterrupt.a. Software trigger is not supported.

config ARM_GIC_V2
    bool "ARM GICv2 interrupt controller"
    depends on ARCH_ARM_AARCH32
    select ARCH_INTERRUPT_TAKEOVER
    help
      ARM Generic Interrupt Controller v2. Used by Cortex-A7
      (Hi3516DV300, QEMU ARM virt). Compatible with GICv1.

config ARM_GIC_V3
    bool "ARM GICv3 interrupt controller"
    select ARCH_INTERRUPT_TAKEOVER
    help
      ARM Generic Interrupt Controller v3 (EL1 non-secure view, ICC_*
      system-register interface). Used by Cortex-A55 (RK3568 AMP: CPU3
      runs liteos_m while Linux owns CPU0-2 and the GICD, so the driver
      only touches this core's Redistributor + CPU Interface and the
      per-IRQ GICD configuration).

config CORTEX_M_NVIC
    bool "ARM Cortex-M NVIC interrupt controller"
    depends on ARCH_CORTEX_M0_PLUS || ARCH_CORTEX_M3 || ARCH_CORTEX_M4 || ARCH_CORTEX_M7 || ARCH_CORTEX_M33 || ARCH_CORTEX_M55
    select ARCH_INTERRUPT_TAKEOVER
    help
      ARM Nested Vectored Interrupt Controller, built into all
      Cortex-M cores (register layout per ARMv7-M). All Cortex-M
      variants (m3/m4/m7/m33/m55, gcc/iar/keil) consume the shared
      driver-layer implementation in arm_nvic.c.
