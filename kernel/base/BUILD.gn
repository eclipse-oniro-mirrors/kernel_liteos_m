import("//kernel/liteos_m/liteos.gni")

module_name = get_path_info(rebase_path("."), "name")
kernel_module(module_name) {
  sources = [
    "los_init.c",
    "los_hwi.c",
    "sched/sched_sq/los_sched.c",
    "sched/sched_sq/los_sched_tick.c",
    "sched/sched_sq/los_priqueue.c",
    "los_sortlink.c",
    "los_misc.c",
    "los_mp.c",
    "los_percpu.c",
    "los_task.c",
    "los_tick.c",
    "los_exc.c",
    "utils/los_debug.c",
    "utils/los_error.c",
    "utils/los_hook.c",
  ]

  if (!defined(LOSCFG_BOX)) {
    # M5D single shared copy: under BOX los_bitmap.c compiles ONCE in the
    # usr_demo box_usr_mem module (COMMON sections, lds file-name routing)
    # — the box-side allocator (los_multipledlinkhead.c, also common)
    # calls LOS_HighBitGet on every alloc path and must not reach into
    # kernel-flash code from user mode; the kernel cross-calls the COMMON
    # copy instead (COMMON_TEXT is kernel-executable).
    sources += [ "los_bitmap.c" ]

    # M5G-R: under BOX los_printf.c also compiles ONCE in box_usr_mem -
    # the "full PRINTK" for box user code (PRINTK -> LOS_Printf ->
    # OsLogLevelCheck + the lightweight engine; OsLogLevelCheck/g_logString
    # moved in from utils/los_debug.c for this). Without BOX the plain
    # kernel build compiles it here with the full vsnprintf_s engine.
    sources += [ "los_printf.c" ]
  }

  include_dirs = [
    "include",
    "../extended/backtrace",
    "../extended/trace",
    "../extended/trace/cnv",
  ]

  if (defined(LOSCFG_BOX)) {
    # BOX core + task mechanisms (M5A/M5B, relocated from the target demo
    # layer, mirroring refs kernel_s/base/los_box.c + the refs task-module
    # BOX family extracted into los_task_box.c). The box private headers
    # live in base/include (los_box_pri.h + the los_*_pri.h shims).
    # M5C: los_sec.c = SID module core (refs kernel_s/base/los_sec.c
    # reconstruction, see the file header).
    sources += [
      "los_box.c",
      "los_task_box.c",
      "los_sec.c",
    ]

    # M5C: SID-based mux mechanisms (per-box pools + sId resolution),
    # mirroring refs los_mux.c BOX parts; pend/post core stays in
    # los_mux.c.
    if (defined(LOSCFG_BASE_IPC_MUX)) {
      sources += [ "los_mux_box.c" ]
    }

    # M5G: SID-based sem mechanisms (the mux-face shape; per-box pools +
    # sId resolution), pend/post core stays in los_sem.c.
    if (defined(LOSCFG_BASE_IPC_SEM)) {
      sources += [ "los_sem_box.c" ]
    }

    # BOX rename root - the config lives in the arch module next to the
    # headers. kernel/base has no dep edge on arch and arch:public is
    # globally aggregated, so this stays an explicit conditional
    # reference (inert when LOSCFG_BOX is off).
    configs += [ "$LITEOSTOPDIR/arch/arm/cortex_m:box_syscalls" ]
  }

  if (defined(LOSCFG_BASE_IPC_EVENT)) {
    sources += [ "los_event.c" ]
  }
  if (defined(LOSCFG_BASE_CORE_SWTMR)) {
    sources += [
      "los_swtmr.c",
      "debug/los_swtmr_debug.c",
    ]
  }
  if (defined(LOSCFG_BASE_IPC_SEM)) {
    sources += [ "los_sem.c" ]
  }
  if (defined(LOSCFG_BASE_IPC_MUX)) {
    sources += [ "los_mux.c" ]
  }
  if (defined(LOSCFG_BASE_IPC_QUEUE)) {
    sources += [ "los_queue.c" ]
  }

  if (defined(LOSCFG_BASE_IPC_RWSEM)) {
    sources += [ "los_rwsem.c" ]
  }

  if (defined(LOSCFG_BASE_IPC_RINGBUF)) {
    sources += [ "los_ringbuf.c" ]
  }

  if (defined(LOSCFG_DEBUG_MUTEX)) {
    sources += [ "debug/los_mux_debug.c" ]
  }
  if (defined(LOSCFG_DEBUG_SEMAPHORE)) {
    sources += [ "debug/los_sem_debug.c" ]
  }
  if (defined(LOSCFG_DEBUG_QUEUE)) {
    sources += [ "debug/los_queue_debug.c" ]
  }
  if (defined(LOSCFG_DEBUG_SCHED_STATISTICS)) {
    sources += [ "debug/los_sched_debug.c" ]
  }
  if (defined(LOSCFG_KERNEL_MEM_TLSF)) {
    sources += [ "mem/tlsf/los_memory.c" ]
  }
  if (defined(LOSCFG_KERNEL_MEM_BESTFIT)) {
    if (!defined(LOSCFG_BOX)) {
      # M5D single shared copy: under BOX the bestfit allocator, its
      # dlink-table helper and the multipool registry compile ONCE into
      # the shared COMMON sections (targets usr_demo: box_usr_mem routes
      # the whole objects via the linker script) — kernel and boxes
      # execute the same code; only the pool locks go through the mux
      # veneers. Without BOX the plain kernel build compiles them here.
      sources += [
        "mem/bestfit/los_memory.c",
        "mem/bestfit/los_multipledlinkhead.c",
      ]
    }
    include_dirs += [ "mem/bestfit" ]
  }

  if (defined(LOSCFG_KERNEL_MEM_BESTFIT_LITTLE)) {
    sources += [
      "mem/bestfit_little/los_memory.c",
      "mem/bestfit_little/los_heap.c",
    ]
    include_dirs += [ "mem/bestfit_little" ]
  }

  if (defined(LOSCFG_MEM_TASK_STAT)) {
    sources += [
        "mem/common/memstat/los_memstat.c"
    ]
  }

  if (defined(LOSCFG_KERNEL_MEMBOX_STATIC)) {
    sources += [
        "mem/membox/los_membox.c"
    ]
  }

  if (defined(LOSCFG_KERNEL_MEMBOX_DYNAMIC)) {
    sources += [
        "mem/membox/los_membox_dyn.c"
    ]
  }

  if (defined(LOSCFG_MEM_MUL_POOL)) {
    if (!defined(LOSCFG_BOX)) {
      # M5D: under BOX the multipool registry lives in the shared COMMON
      # sections together with the allocator (see the BESTFIT block note).
      sources += [
          "mem/common/multipool/los_multipool.c"
      ]
    }
  }

  if (defined(LOSCFG_KERNEL_MEM_SLAB_EXTENTION)) {
    sources += [
        "mem/slab/los_slab.c",
        "mem/slab/los_slabmem.c",
    ]
  }

  configs += [ "$LITEOSTOPDIR:warn_config" ]
}
