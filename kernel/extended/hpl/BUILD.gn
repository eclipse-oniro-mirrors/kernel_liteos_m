import("//kernel/liteos_m/liteos.gni")

module_switch = defined(LOSCFG_KERNEL_HPL)
module_name = get_path_info(rebase_path("."), "name")

# Source combination aligned with the fbb CMakeLists.txt:
#   base           : los_hpl_logger_common.c
#   !SCRIPT        : + los_hpl_c_preprocessor.c
#   TASK_LOCK_FREE : + task_lock_free/{ringbuf,logger,compression}.c
#   else           : + task_locked/los_hpl_logger.c
#   EMULATION      : + los_hpl_decompression.c + los_hpl_emulation.c
kernel_module(module_name) {
  sources = [ "src/los_hpl_logger_common.c" ]

  if (!defined(LOSCFG_KERNEL_HPL_SCRIPT_PREPROCESSOR)) {
    sources += [ "src/los_hpl_c_preprocessor.c" ]
  }

  if (defined(LOSCFG_KERNEL_HPL_TASK_LOCK_FREE)) {
    sources += [
      "src/task_lock_free/los_hpl_ringbuf.c",
      "src/task_lock_free/los_hpl_logger.c",
      "src/task_lock_free/los_hpl_compression.c",
    ]
  } else {
    sources += [ "src/task_locked/los_hpl_logger.c" ]
  }

  if (defined(LOSCFG_DEBUG_HPL_EMULATION)) {
    sources += [
      "src/los_hpl_decompression.c",
      "src/los_hpl_emulation.c",
    ]
  }

  configs += [ "$LITEOSTOPDIR:warn_config" ]
}

config("public") {
  include_dirs = [
    "include",
    "../include",
  ]
}
