# RK3568 AMP board (liteos_m, AArch64 EL1 on CPU3).

import("//kernel/liteos_m/liteos.gni")

module_name = "board"
kernel_module(module_name) {
  sources = [
    "board.c",
    "main.c",
    "reset_vector.S",
    "uart_porting.c",
  ]

  # Modbus-RTU oriented UART driver (uart_drv.h API), independent of the
  # console path above (uart_porting.c).
  if (defined(LOSCFG_RK3568_UART)) {
    sources += [ "uart.c" ]
  }

  # The image carries the libmica pedestal resource table (kernel/liteos_m/
  # compat/mcs/mica/libmica/src/pedestals/ped_rsc_table.c) as its single
  # .resource_table, which the master mcs_km loader parses and patches (the
  # manual bring-up files openamp_init.c/resource_table.c were removed).
  if (defined(LOSCFG_MCS)) {
    # main.c includes the build-time generated metal/ and mica/ include
    # sets; depend on the generator action for ordering.
    deps = [ "//kernel/liteos_m/components/openamp:mcs_includes" ]
  }

  # Real-time NIC data plane on GMAC1 (bring-up done by the master-side
  # mcs_net.ko; this is the slave data path + the net self-test task).
  # Driver source: net/net_dwmac.c against the protocol-agnostic net.h
  # contract (runtime-configurable mode, link policy and rx filter).
  if (defined(LOSCFG_MCS_NET)) {
    sources += [
      "net/net_dwmac.c",
      "net_test.c",
    ]
  }

  # Real-time CAN data plane on CAN1 (bring-up is done by the
  # master-side mcs_can.ko; this is the slave data path + the can
  # self-test task). Driver source: can/can_rk3568.c against the
  # protocol-agnostic can.h contract (runtime-configurable rx mode, work
  # mode and bit timing).
  if (defined(LOSCFG_MCS_CAN)) {
    sources += [
      "can/can_rk3568.c",
      "can_test.c",
    ]
  }

  # mica rpc service probe + socket proxy demo (netproxy_test.c): the
  # rpmsg-rpc endpoint (libmica rpc_service.c) plus the np_* socket
  # proxy API (libmica net_service.c) forwarding BSD socket calls to
  # the master netproxy worker.
  if (defined(LOSCFG_MCS_RPC)) {
    sources += [ "netproxy_test.c" ]
  }

  # Shared-free SoC timer data plane (TIMER1): unlike net/can there is
  # NO master precondition (the master never touches the SoC TIMER
  # block), the driver self-serves the CRU clock gate + reset. Driver
  # source: timer/timer_rk3568.c against the protocol-agnostic timer.h
  # contract (oneshot/periodic, irq or polled); timer_test.c is the
  # phase-driven self-test demo.
  if (defined(LOSCFG_MCS_TIMER)) {
    sources += [
      "timer/timer_rk3568.c",
      "timer_test.c",
    ]
  }

  include_dirs = [
    "include",
    ".",
    "can",
    "net",
    "timer",
    "//kernel/liteos_m/testsuites/include",
  ]
}

config("public") {
  include_dirs = [
    ".",
    "include",
  ]

  ldflags = [
    "-fuse-ld=lld",
    "-nostartfiles",
    "-nostdlib",
    "-Wl,-T" + rebase_path("//device/board/hihope/rk3568_m/liteos_m/board/board.ld"),
    "-Wl,--gc-sections",
    "-Wl,--whole-archive",
    board_clang_rt_lib,
    "-Wl,--no-whole-archive",
  ]
}
