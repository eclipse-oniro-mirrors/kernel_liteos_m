# STM32F407VET6 board build, modeled on arm_mps2_an386/liteos_m/board/BUILD.gn.
# Trimmed: no fs/net drivers, no shell hooks, no board testcases.

import("//kernel/liteos_m/liteos.gni")

module_name = "bsp_config"

kernel_module(module_name) {
  asmflags = board_asmflags

  # linker script template expansion must run before the final link
  deps = [ ":gen_liteos_ld" ]

  # Section routing for this module only (kernel modules stay default):
  # LITE_OS_SEC_* -> .kernel.text/.data/.bss, .box.res, .usr.text ... 
  # All collected by liteos.ld (see los_builddef_target.h mapping).
  cflags = [
    "-include",
    rebase_path("include/los_builddef_target.h"),
  ]

  sources = [
    "driver/uart.c",
    "libc/dprintf.c",
    "main.c",
    "startup.s",
  ]

  if (defined(LOSCFG_BOX)) {
    # BOX kernel world: target-side box sources. The syscall machinery
    # (table / veneers / svc entry) lives in the arch module
    # (arch/arm/cortex_m/box), so only the truly target-owned
    # pieces stay here: the offsets asserts and the box address config.
    sources += [
      "../box/offsets/los_offsets.c",
      "../box/boxes_cfg/boxes_conf.c",
    ]
    configs += [ "$LITEOSTOPDIR/arch/arm/cortex_m:box_syscalls" ]
    deps += [
      # box user world (stub syscalls.h root + veneer-linked LOS_xxx)
      "../box/usr_demo:box_usr_demo",
      # usr shared copy of the bestfit allocator (COMMON_TEXT
      # direct-call for alloc/free; locks via the mux veneers)
      "../box/usr_demo:box_usr_mem",
      # asm-offsets regeneration: runs before this module compiles
      # (los_offsets.c asserts against the freshly generated header)
      "../box/offsets:gen_box_offsets",
    ]

    if (defined(LOSCFG_KERNEL_TEST)) {
      # UTS single-copy test runner (iCunit + phase flag in the COMMON
      # sections): test builds only - demo builds never link it in.
      deps += [ "../box/usr_demo:box_usr_test" ]
    }
  }
}

# Single linker-script source: liteos.ld.in carries the one coverage-vs-stock
# difference (four FLASH slot sizes/origins) inside #ifdef. GNU ld does not
# run cpp on linker scripts (#ifdef in a .ld is dead text - both MEMORY
# blocks used to land and the later one won), so this action expands the
# template into the plain .ld the linker consumes. Both stock and coverage
# builds link the generated script; the stock expansion differs from the
# historical liteos.ld only by comments (verified: same link product, demo
# anchor unchanged).
action("gen_liteos_ld") {
  script = "gen_liteos_ld.py"
  inputs = [ "liteos.ld.in" ]
  outputs = [ "$target_out_dir/liteos.ld" ]
  args = [
    rebase_path("liteos.ld.in"),
    rebase_path("$target_out_dir/liteos.ld"),
  ]
  if (defined(LOSCFG_TEST_KERNEL_COVERAGE)) {
    args += [ "--cov" ]
  }
}

config("public") {
  include_dirs = [
    ".",
    "include",
    "driver",
    "../box/kernel",
    "../box/boxes_cfg",
  ]
  _ld_script = rebase_path(get_label_info(":gen_liteos_ld", "target_out_dir") + "/liteos.ld")
  ldflags = [
    "-nostartfiles",
    "-Wl,-T" + _ld_script,
    "-nostdlib",
  ]

  if (defined(LOSCFG_BOX)) {
    ldflags += [ "-Wl,-T" + rebase_path("../box/boxes_cfg/boxes.ld") ]
  }

  libs = [
    "nosys",
    "gcc",
  ]

  if (defined(LOSCFG_LIBC_NEWLIB)) {
    ldflags -= [ "-nostdlib" ]
    libs -= [ "nosys" ]
    libs += [
      "c",
      "m",
    ]
  }
}
