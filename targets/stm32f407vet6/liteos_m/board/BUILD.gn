# STM32F407VET6 board build, modeled on arm_mps2_an386/liteos_m/board/BUILD.gn.
# Trimmed: no fs/net drivers, no shell hooks, no board testcases.

import("//kernel/liteos_m/liteos.gni")

module_name = "bsp_config"

kernel_module(module_name) {
  asmflags = board_asmflags

  # Section routing for this module only (kernel modules stay default):
  # LITE_OS_SEC_* -> .kernel.text/.data/.bss, .box.res, .usr.text ... 
  # All collected by liteos.ld (see los_builddef_target.h mapping).
  cflags = [
    "-include",
    rebase_path("include/los_builddef_target.h"),
  ]

  sources = [
    "driver/uart.c",
    "libc/dprintf.c",
    "main.c",
    "startup.s",
  ]

  if (defined(LOSCFG_BOX)) {
    # BOX kernel world: target-side box sources. M5G-R: the syscall
    # machinery (table/veneers/svc entry) moved to the arch syscalls root
    # (arch/arm/cortex_m/syscalls/src, compiled by the arch module) - only
    # the truly target-owned pieces stay here (offsets asserts, box
    # address config).
    sources += [
      "../box/offsets/los_offsets.c",
      "../box/boxes_cfg/boxes_conf.c",
    ]
    configs += [ "$LITEOSTOPDIR/arch/arm/cortex_m:box_syscalls" ]
    deps = [
      # box user world (stub syscalls.h root + veneer-linked LOS_xxx)
      "../box/usr_demo:box_usr_demo",
      # M5D usr shared copy of the bestfit allocator (COMMON_TEXT
      # direct-call for alloc/free; locks via the mux veneers)
      "../box/usr_demo:box_usr_mem",
      # asm-offsets regeneration: runs before this module compiles
      # (los_offsets.c asserts against the freshly generated header)
      "../box/offsets:gen_box_offsets",
    ]
  }
}

config("public") {
  include_dirs = [
    ".",
    "include",
    "driver",
    "../box/kernel",
    "../box/boxes_cfg",
  ]
  ldflags = [
    "-nostartfiles",
    "-Wl,-T" + rebase_path("liteos.ld"),
    "-nostdlib",
  ]

  if (defined(LOSCFG_BOX)) {
    ldflags += [ "-Wl,-T" + rebase_path("../box/boxes_cfg/boxes.ld") ]
  }

  libs = [
    "nosys",
    "gcc",
  ]

  if (defined(LOSCFG_LIBC_NEWLIB)) {
    ldflags -= [ "-nostdlib" ]
    libs -= [ "nosys" ]
    libs += [
      "c",
      "m",
    ]
  }
}
