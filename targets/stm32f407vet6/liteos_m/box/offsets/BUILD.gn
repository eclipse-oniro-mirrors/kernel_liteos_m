# BOX asm-offsets generation, wired into the build graph.
#
# Regenerates box/kernel/los_offsets.h from the TaskCB/TaskContext
# struct definitions on every build - the manual gen_offsets.py run is no
# longer needed. The header is written at its source-tree location so every
# existing relative #include keeps working; the ninja-declared output is an
# out-dir stamp. The script compare-and-swaps the header and, only on real
# changes, bumps the mtimes of the consumer sources - that bump is what
# recompiles them, because this build has no depfiles (pitfall 27).
#
# Consumers (each must keep a deps edge on this action for ordering, and a
# --touch entry for recompilation):
#   bsp_config: los_offsets.c
#   arch:       los_dispatch_box.S, los_box_uspace.S and (M5G-R, moved from
#               targets/box/syscalls) syscalls/src/los_syscall_entry.S +
#               syscalls/src/los_svc_entry.S

action("gen_box_offsets") {
  script = "gen_offsets.py"

  # Paths relative to the build root (ninja runs with cwd = build root).
  args = [
    "--kernel-dir", rebase_path("//kernel/liteos_m", root_build_dir),
    "--out-dir", rebase_path("$root_out_dir", root_build_dir),
    "--source", rebase_path("los_offsets.c", root_build_dir),
    "--output", rebase_path(
        "//kernel/liteos_m/targets/stm32f407vet6/liteos_m/box/kernel/los_offsets.h",
        root_build_dir),
    "--stamp", rebase_path("$target_gen_dir/los_offsets.h.stamp", root_build_dir),
    "--touch", rebase_path("los_offsets.c", root_build_dir),
    "--touch", rebase_path(
        "//kernel/liteos_m/arch/arm/cortex_m/syscalls/src/los_syscall_entry.S",
        root_build_dir),
    "--touch", rebase_path(
        "//kernel/liteos_m/arch/arm/cortex_m/syscalls/src/los_svc_entry.S",
        root_build_dir),
    "--touch", rebase_path(
        "//kernel/liteos_m/arch/arm/cortex_m/los_dispatch_box.S",
        root_build_dir),
    "--touch", rebase_path("//kernel/liteos_m/arch/arm/cortex_m/los_box_uspace.S",
                           root_build_dir),
  ]

  # Struct-defining inputs: any change here reruns the action. Extend this
  # list when adding a new struct-conditional field. NOTE: config.h (which
  # drives the LOSCFG_* layout switches - JOINABLE / EVENT / SIGNAL / BOX)
  # is generated by hb before gn runs and therefore cannot be declared as
  # an input - product-config changes need a manual rebuild of this file's
  # consumers (they force a full rebuild anyway).
  inputs = [
    "gen_offsets.py",
    "los_offsets.c",
    "//kernel/liteos_m/kernel/base/include/los_task_base.h",
    "//kernel/liteos_m/arch/arm/cortex_m/los_arch_context.h",
    "//kernel/liteos_m/kernel/include/los_typedef.h",
  ]

  outputs = [ "$target_gen_dir/los_offsets.h.stamp" ]
}
