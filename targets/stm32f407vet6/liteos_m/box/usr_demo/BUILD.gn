# Box user-demo module - the USER world of the two-world syscall split.
# Compiled with the usr-side include root only: los_base.h resolves
# "kernel/syscalls.h" to the EMPTY stub (box/include/usr), so the
# LOS_xxx -> SYS_LOS_xxx rename never exists here and box code links the
# COMMON_TEXT veneers of the plain names.

import("//kernel/liteos_m/liteos.gni")

# Single shared copy of the bestfit allocator: the allocator lives in the
# COMMON sections. Under BOX this is the ONLY compilation of los_memory.c:
# the kernel/base module drops the source
# (see kernel/base/BUILD.gn) and the linker script routes the whole
# object into .COMMON_TEXT/.COMMON_DATA — kernel and boxes execute the
# same code; boxes call alloc/free/init directly, only the pool locks go
# through the LOS_MuxPend/Post veneers. LOSCFG_MEM_MUL_POOL is OFF:
# los_multipool.c is not compiled in either world (the registry does not
# exist; kernel/base/BUILD.gn drops it too). No builddef force-include
# and no rename: plain sections (.text.* / .bss.*) are caught by the
# lds file-name rules.
kernel_module("box_usr_mem") {
  # aggregated by board:bsp_config (final image link), outside the
  # usr_demo directory chain the liteos.gni template defaults to
  visibility += [ "//kernel/liteos_m/targets/stm32f407vet6/liteos_m/board:*" ]

  cflags = [
    "-mfpu=fpv4-sp-d16",
    "-mfloat-abi=softfp",
  ]

  sources = [
    "//kernel/liteos_m/kernel/base/mem/bestfit/los_memory.c",
    "//kernel/liteos_m/kernel/base/mem/bestfit/los_multipledlinkhead.c",
    # LOS_HighBitGet (every dlink alloc/free path) must live in the COMMON
    # copy with the allocator — a kernel-flash landing is a user-mode
    # MemManage fault; kernel callers cross-call the COMMON copy (R0).
    "//kernel/liteos_m/kernel/base/los_bitmap.c",
    # The full PRINTK for box user code (PRINTK -> LOS_Printf ->
    # OsLogLevelCheck + UartOutput chain). Same file-name lds routing as
    # the others. LOS_PRINTF_COMMON_ENGINE selects the lightweight
    # in-file formatter and routes the output through the UartPuts
    # syscall (the uart driver + its LOS_IntLock stay in the kernel
    # segment); the BOX=off kernel build keeps the full vsnprintf_s
    # engine with the direct UartPuts call.
    "//kernel/liteos_m/kernel/base/los_printf.c",
  ]

  # The multipool registry shares the allocator's fate: under BOX it compiles
  # ONCE here (kernel/base/BUILD.gn drops it in the BOX branch) so that the
  # per-box dispatch AND the g_usrBoxPoolHead registry land in the COMMON
  # sections. Both halves have to be user-reachable - a box walks its own list
  # with this code, and OsMemMulPoolInit writes the list head, so the registry
  # must sit in COMMON_BSS (R1, RW for kernel and boxes), not kernel .bss.
  if (defined(LOSCFG_MEM_MUL_POOL)) {
    sources += [
      "//kernel/liteos_m/kernel/base/mem/common/multipool/los_multipool.c",
    ]
  }

  defines = [ "LOS_PRINTF_COMMON_ENGINE=1" ]

  include_dirs = [
    # los_memory_internal.h (bestfit-private header)
    "//kernel/liteos_m/kernel/base/mem/bestfit",
    # los_trace.h / los_exc_pri.h chains pulled by los_memory.c
    "//kernel/liteos_m/kernel/extended/trace",
    "//kernel/liteos_m/kernel/extended/trace/cnv",
    "//kernel/liteos_m/kernel/extended/backtrace",
  ]
}

kernel_module("box_usr_demo") {
  # aggregated by board:bsp_config (final image link)
  visibility += [ "//kernel/liteos_m/targets/stm32f407vet6/liteos_m/board:*" ]

  # Same section-routing force-include as bsp_config (LITE_OS_SEC_* ->
  # .box.res / .boxA.bss / .boxB.bss ...).
  cflags = [
    "-include",
    rebase_path("../../board/include/los_builddef_target.h"),
    # VFPv4 codegen for the user world. The ABI tag must match the rest
    # of the image (the linker refuses to merge VFP-register-argument
    # objects into a soft-float image), so this stays softfp: real VFP
    # instructions, core-register calling convention.
    "-mfpu=fpv4-sp-d16",
    "-mfloat-abi=softfp",
  ]

  sources = [
    "tboxA/boxA_main.c",
    "tboxB/boxB_main.c",
    # The user-world API wrappers (los_usr_api.c) moved to kernel/box: they
    # are refs kernel_s/usr mechanism, not demo code, and live beside
    # los_usr_init.c now. Built by kernel/box:box_usr, which compiles them
    # without the rename root - the same requirement this module satisfies.
  ]

  if (defined(LOSCFG_KERNEL_TEST)) {
    # UTS: the test-build boxA entry (parks on the shared phase flag,
    # runs the usr suites through the shared iCunit, publishes DONE).
    # The demo boxAEntry stays compiled (its resource tables g_boxaStack/
    # g_boxaTaskCB/... are referenced by boxes_auto.cfg) - unreferenced
    # code is gc'd except what boxes.ld KEEP retains.
    sources += [ "tboxA/boxA_test_main.c" ]

    # uts_phase.h (testsuites/include). Raw include dir only - NOT the
    # testsuites ":include" config (it chains the kernel rename root,
    # which must never reach box user TUs).
    include_dirs = [ "//kernel/liteos_m/testsuites/include" ]
  }
}

# UTS single-copy test runner (same M5D pattern as box_usr_mem above):
# under LOSCFG_KERNEL_TEST the testsuites test_init module DROPS its
# iCunit.c/icunit_filter.c copies and this module compiles them ONCE -
# liteos.ld routes the whole objects (file-name rules, *box_usr_test.*.o)
# into .COMMON_TEXT / .COMMON_DATA / .COMMON_BSS, so the kernel phase
# (IT_TST_INI) and the usr phase (boxA test entry) execute the SAME runner
# code and share the SAME state: case slot, module stats, fail logs and
# the g_passResult/g_failResult counters (defined in the shared iCunit.c
# under LOSCFG_BOX - one unified report). uts_phase.c carries the
# two-phase handshake variable g_utsPhase (COMMON_RAM, RW both worlds).
# The module is linked only from board BUILD.gn under LOSCFG_KERNEL_TEST;
# demo builds never reference it (nothing routes it in).
kernel_module("box_usr_test") {
  visibility += [ "//kernel/liteos_m/targets/stm32f407vet6/liteos_m/board:*" ]

  cflags = [
    "-mfpu=fpv4-sp-d16",
    "-mfloat-abi=softfp",
  ]

  sources = [
    "//kernel/liteos_m/testsuites/src/iCunit.c",
    "//kernel/liteos_m/testsuites/src/icunit_filter.c",
    "//kernel/liteos_m/testsuites/src/uts_phase.c",
  ]

  include_dirs = [
    # iCunit.h / osTest.h / iCunit_config.h / icunit_* headers. Raw
    # include dir on purpose: NO rename root (usr/syscalls.h), NO kernel
    # rename (box_syscalls) - the runner's own LOS_ surface is empty under
    # LOSCFG_BOX (time stats compiled out, resleak stubbed), and osTest.h's
    # dprintf resolves to the COMMON PRINTK copy, callable from both worlds.
    "//kernel/liteos_m/testsuites/include",
  ]
}

config("public") {
  include_dirs = [
    # usr world root: #include "syscalls.h" resolves the user-side
    # prototypes header. The root carries no kernel/ subdir, so
    # los_base.h's __has_include("kernel/syscalls.h") stays FALSE in
    # user TUs - the rename header is unreachable from the user world.
    rebase_path("//kernel/liteos_m/arch/arm/cortex_m/box/include/usr"),
    # boxes_conf.h / boxes_res_conf.h / boxes_res_auto.cfg
    "../boxes_cfg",
  ]
}
