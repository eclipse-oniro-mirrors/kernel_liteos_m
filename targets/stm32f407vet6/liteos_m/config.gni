# STM32F407VET6 board config, modeled on arm_mps2_an386/liteos_m/config.gni.

# Kernel type, e.g. "linux", "liteos_a", "liteos_m".
kernel_type = "liteos_m"

# Kernel version.
kernel_version = "3.0.0"

# Board CPU type, e.g. "cortex-a7", "riscv32".
board_cpu = "cortex-m4"

# Board arch, e.g.  "armv7-a", "rv32imac".
board_arch = ""

# Toolchain name used for system compiling.
board_toolchain = "arm-none-eabi-gcc"

use_board_toolchain = true

declare_args() {
  hpl_use_wrapper = false
}

if (hpl_use_wrapper) {
  board_toolchain_path = rebase_path("$root_out_dir/hpl/toolchain")
} else {
  board_toolchain_path = ""
}

# Compiler prefix.
board_toolchain_prefix = "arm-none-eabi-"

# Compiler type, "gcc" or "clang".
board_toolchain_type = "gcc"

# Debug compiler optimization level options.
board_opt_flags = []

# Board related common compile flags.
board_cflags = [
  "-mthumb",
  "-Wall",
  "-fdata-sections",
  "-ffunction-sections",
  "-fno-builtin",
  "-fno-strict-aliasing",
  "-fsigned-char",
  "-std=c99",
  "-O2",
  "-D__LITEOS_M__",
]
board_cflags += board_opt_flags

board_asmflags = [
  "-mcpu=cortex-m4",
  "-mthumb",
  "-static",
  "-O2",
]
board_asmflags += board_opt_flags

board_cxx_flags = board_cflags

board_ld_flags = []

# Newlib adapt.
board_ld_flags += [
  "-Wl,--wrap=_free_r",
  "-Wl,--wrap,_malloc_usable_size_r",
  "-Wl,--wrap,_malloc_r",
  "-Wl,--wrap=_memalign_r",
  "-Wl,--wrap,_realloc_r",
  "-Wl,--wrap=_calloc_r",
]

# Board related headfiles search path.
board_include_dirs = [ "//commonlibrary/utils_lite/include" ]

# Board adapter dir for OHOS components.
board_adapter_dir = "//device/st/stm32f407vet6/driver"

# Sysroot path.
board_configed_sysroot = ""

# Board storage type, it used for file system generation.
storage_type = ""
