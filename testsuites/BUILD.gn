import("//kernel/liteos_m/config.gni")
import("//kernel/liteos_m/liteos.gni")

config("kernel_test_coverage") {
  if (defined(LOSCFG_TEST_KERNEL_COVERAGE)) {
    cflags = [
      "-fprofile-arcs",
      "-ftest-coverage",
    ]
    if (defined(LOSCFG_PLATFORM_QEMU_ARM_VIRT_CM4)) {
      # arm gcc 10.3 -fprofile-arcs miscompiles optimized-routines string
      # functions (gcov counter prologue ldrd clobbers a live argument
      # register, so strcpy-family calls copy from address 0).
      # ★ 必须保持单个旗标（组合正则）：GCC 对多个 -fprofile-exclude-files
      #   取 last-wins，第二个会覆盖第一个（实测）。
      cflags += [ "-fprofile-exclude-files=.*third_party.*optimized-routines.*" ]
      # ★ 覆盖率构建须关闭栈保护：gcc 10.3 会无视 naked 属性向裸函数注入
      #   canary 序言（ldr/ldr/str [sp,#4]），把 __stack_chk_guard 写到
      #   调用者栈帧 [sp+4]——实测踩坏 lfs_dir_read 保存的 r4（= 调用者
      #   gcov 基址），ItLosShell012 处 ldrd [r4+0x30] 以 0xd00a0dff 崩溃
      #   （__stack_chk_guard 的 WEAK 初值）。-fno-stack-protector 靠
      #   last-wins 盖过 ssp_config 的 -fstack-protector-all；仅影响
      #   CM4 的覆盖率（测试专用）构建，发布构建不受影响。
      cflags += [ "-fno-stack-protector" ]
    }
    # 注: riscv gcc 7.3 不支持 -fprofile-exclude-files(GCC 8+), ws63 侧对非
    # 30 目标目录(shell/cmsis/lms/pm/cpup/backtrace)的插桩排除改由 liteos.gni
    # 的 kernel_module 模板追加 no_test_coverage 实现(见该处注释)。
    cflags_cc = cflags
  }
}

config("no_test_coverage") {
  if (defined(LOSCFG_TEST_KERNEL_COVERAGE)) {
    cflags = [
      "-fno-profile-arcs",
      "-fno-test-coverage",
    ]
    cflags_cc = cflags
  }
}

config("include") {
  # Test code must not be instrumented: chain the single-point exclusion
  # config above whose -fno-* flags override the -fprofile-arcs
  # -ftest-coverage injected via los_config (GCC last-wins). Every
  # testsuites kernel_module pulls this config in.
  configs = [ ":no_test_coverage" ]

  defines = []
  include_dirs = [ "include" ]

  if (defined(LOSCFG_KERNEL_TEST_FULL)) {
    defines += [ "LOS_KERNEL_TEST_FULL=1" ]
  }
  if (defined(LOSCFG_KERNEL_TEST_MANUAL)) {
    defines += [ "LOS_KERNEL_TEST_MANUAL=1" ]
  }
  # LOSCFG_KERNEL_FUZZ (Kconfig, mutually exclusive with LOSCFG_KERNEL_TEST)
  # Filter out -Werror and -Wno-address-of-packed-member from the warn config.
  # Test code contains pre-existing warnings (sign-compare, type-limits,
  # unused-parameter) that are accepted by GCC >= 9 but cause hard errors on
  # older toolchains (e.g. ws63 riscv32 gcc 7.3). Additionally,
  # -Wno-address-of-packed-member is unrecognized by GCC < 9 and triggers
  # cc1 "unrecognized command line option" errors when -Werror is active.
  _test_cflags = []
  foreach(flag, warn_config_cflags) {
    if (!defined(LOSCFG_ARCH_RISCV) ||
        (flag != "-Werror" && flag != "-Wno-address-of-packed-member")) {
      _test_cflags += [ flag ]
    }
  }
  cflags = _test_cflags
  asmflags = _test_cflags
  if (ohos_build_compiler == "clang") {
    # clang 15 对测试代码存量告警类的降级(同上 -Werror 过滤同理,仅测试侧生效)
    cflags += [
      "-Wno-error=strict-prototypes",
      "-Wno-error=typedef-redefinition",
      "-Wno-error=sometimes-uninitialized",
      "-Wno-error=string-compare",
      "-Wno-error=tautological-constant-out-of-range-compare",
    ]
  }
}

module_switch = defined(LOSCFG_TEST)
kernel_module("test_init") {
  sources = [
    "src/iCunit.c",
    "src/icunit_filter.c",
    "src/osTest.c",
    "src/ram_lfs_backend.c",
    "src/test_common.c",
    "src/los_resleak_test.c",
  ]

  include_dirs = [
    "unittest/posix/src",
    "unittest/xts",
    # ram_lfs_backend.c: los_fs.h (mount/umount/LOS_DiskPartition/PartitionCfg)
    # 与 securec.h; 文件体仅 riscv 测试板非空(qemu/hi3322 走各自板级挂载)
    "//kernel/liteos_m/fs/vfs",
    "//third_party/bounds_checking_function/include",
  ]

  configs += [ ":include" ]
}

group("testsuites") {
  deps = [ ":test_init" ]

  # mutually exclusive build modes (Kconfig): normal suites vs fuzz-only
  if (defined(LOSCFG_KERNEL_TEST)) {
    # Per-directory selection (Kconfig TEST_ICUNIT_* / TEST_UNI_*): block
    # order mirrors the original flat dep list so an all-defaults build
    # keeps the exact same dep-graph order (archive members / layout).
    if (defined(LOSCFG_TEST_ICUNIT_KERNEL)) {
      deps += [
        "sample/kernel/event:test_event",
        "sample/kernel/hwi:test_hwi",
        "sample/kernel/mem:test_mem",
        "sample/kernel/mux:test_mux",
        "sample/kernel/queue:test_queue",
        "sample/kernel/sem:test_sem",
        "sample/kernel/rwsem:test_rwsem",
        "sample/kernel/swtmr:test_swtmr",
        "sample/kernel/task:test_task",
        "sample/kernel/misc:test_misc",
        "sample/kernel/tcb_verify:test_tcb_verify",
        "sample/kernel/atomic:test_atomic",
        "sample/kernel/uart:test_uart",
      ]
    }
    # exc suite: osTest.h enables LOS_KERNEL_EXC_TEST when
    # SHELL_EXCINFO_DUMP or BACKTRACE_TYPE!=0 - align the BUILD dep with
    # that condition (the destructive cases are MANUAL-gated; the remaining
    # aarch64-safe cases are backtrace walks + exc-hook registration).
    if (defined(LOSCFG_TEST_ICUNIT_KERNEL) &&
        (defined(LOSCFG_SHELL_EXCINFO_DUMP) ||
         (defined(LOSCFG_BACKTRACE_TYPE) && LOSCFG_BACKTRACE_TYPE != 0))) {
      deps += [ "sample/kernel/exc:test_exc" ]
    }
    # posix/xts suites rely on 32-bit-target musl semantics
    # (pthread_t as integer, *timeofday64) and a C++ xts build not
    # available on aarch64 targets.
    if (defined(LOSCFG_TEST_ICUNIT_POSIX) &&
        !defined(LOSCFG_ARCH_ARM_AARCH64)) {
      deps += [ "sample/posix:test_posix" ]
    }
    if (defined(LOSCFG_TEST_UNI_POSIX) &&
        !defined(LOSCFG_ARCH_ARM_AARCH64)) {
      deps += [ "unittest/posix:posix_test" ]
    }
    if (defined(LOSCFG_TEST_UNI_XTS) &&
        !defined(LOSCFG_ARCH_ARM_AARCH64)) {
      deps += [ "unittest/xts:xts_test" ]
    }
  }
  if (defined(LOSCFG_KERNEL_FUZZ)) {
    deps += [
      "src/fuzz:fuzz_common",
      "sample/fuzz:fuzzapi_test",
    ]
  }

  # MCS AMP interface suites (sample/mcs): board drivers (can/net),
  # mica service framework and np_* socket proxy. Only when the MCS
  # pedestal is compiled in (targets/rk3568_m board).
  if (defined(LOSCFG_KERNEL_TEST) && defined(LOSCFG_MCS)) {
    deps += [ "sample/mcs:test_mcs" ]
  }

  # Conditional so that a coverage-off build keeps the exact same dep-graph
  # traversal order as a tree without this code: an unconditional dep would
  # reorder the archive members and shift the linked layout (byte-diff vs a
  # pristine build even though the module itself is empty).
  if (defined(LOSCFG_TEST_KERNEL_COVERAGE)) {
    deps += [ "src/gcov" ]
  }

  if (defined(LOSCFG_KAL_CMSIS) && defined(LOSCFG_TEST_ICUNIT_CMSIS)) {
    deps += [ "sample/cmsis:test_cmsis" ]
  }
  if (defined(LOSCFG_ARCH_CACHE) && defined(LOSCFG_TEST_ICUNIT_KERNEL)) {
    deps += [ "sample/kernel/cache:test_cache" ]
  }
  if (defined(LOSCFG_BASE_CORE_CPUP) && defined(LOSCFG_TEST_ICUNIT_KERNEL)) {
    deps += [ "sample/kernel/cpup:test_cpup" ]
  }
  if (defined(LOSCFG_BASE_IPC_RWSEM) && defined(LOSCFG_TEST_ICUNIT_KERNEL)) {
    deps += [ "sample/kernel/rwsem:test_rwsem" ]
  }
  if (defined(LOSCFG_DYNLINK) && defined(LOSCFG_TEST_ICUNIT_KERNEL)) {
    deps += [ "sample/kernel/dynlink:test_dynlink" ]
  }
  if (defined(LOSCFG_KERNEL_DYNLOAD) && defined(LOSCFG_TEST_ICUNIT_KERNEL) &&
      (defined(LOSCFG_ARCH_ARM_AARCH32) || defined(LOSCFG_ARCH_RISCV))) {
    deps += [ "sample/kernel/dynload:test_dynload" ]
  }
  if (defined(LOSCFG_KERNEL_LMS) && defined(LOSCFG_TEST_ICUNIT_KERNEL)) {
    deps += [ "sample/kernel/lms:test_lms" ]
  }
  if (defined(LOSCFG_KERNEL_HPL) && defined(LOSCFG_TEST_ICUNIT_KERNEL)) {
    deps += [ "sample/kernel/hpl:test_hpl" ]
  }
  if (defined(LOSCFG_KERNEL_TRACE) && defined(LOSCFG_TEST_ICUNIT_KERNEL)) {
    deps += [ "sample/kernel/trace:test_trace" ]
  }
  if (defined(LOSCFG_KERNEL_LMK) && defined(LOSCFG_TEST_ICUNIT_KERNEL)) {
    deps += [ "sample/kernel/lmk:test_lmk" ]
  }
  if (defined(LOSCFG_KERNEL_SIGNAL) && defined(LOSCFG_TEST_ICUNIT_KERNEL)) {
    deps += [ "sample/kernel/signal:test_signal" ]
  }
  if (defined(LOSCFG_KERNEL_PM) && defined(LOSCFG_TEST_ICUNIT_KERNEL)) {
    deps += [ "sample/kernel/power:test_pm" ]
  }
  if (defined(LOSCFG_SHELL) && defined(LOSCFG_TEST_ICUNIT_KERNEL)) {
    deps += [ "sample/kernel/shell:test_shell" ]
  }
  if (!module_switch) {
    deps = []
  }
}
