#
# Cache maintenance interface test suite (ws63 arch/cache.h). Gated by
# LOSCFG_ARCH_CACHE (the arch/risc-v/src/los_cache.c provider must be
# compiled for the ArchICache*/ArchDCache* symbols to resolve) and
# LOSCFG_KERNEL_TEST.

import("//kernel/liteos_m/liteos.gni")

static_library("test_cache") {
  sources = [
    "it_los_cache.c",
    "it_los_cache_001.c",
    "it_los_cache_002.c",
    "it_los_cache_003.c",
    "it_los_cache_004.c",
    "it_los_cache_005.c",
    "it_los_cache_006.c",
    "it_los_cache_007.c",
    "it_los_cache_008.c",
    "it_los_cache_009.c",
    "it_los_cache_010.c",
    "it_los_cache_011.c",
    # it_los_cache_012.c 重新隔离: A 段在任务运行中调用全量 ArchDCacheInvalidate
    # (纯 DCIV 不回写) 会丢任务栈脏行导致 ra 损坏, 系用例设计缺陷, 非库侧问题。
    "it_los_cache_013.c", # 接口覆盖: enable 幂等/重复使能
    "it_los_cache_014.c", # 边界条件: 精确 cache line 边界
    "it_los_cache_015.c", # 功能完备度: flush/clean/invalidate 语义
    "it_los_cache_016.c", # 接口覆盖: flush_dcache/flush_icache 宏
    "it_los_cache_017.c", # 回归: 源码化后中断安全回归
  ]

  include_dirs = [ "." ]

  configs += [ "$LITEOSTOPDIR/testsuites:include" ]
}
