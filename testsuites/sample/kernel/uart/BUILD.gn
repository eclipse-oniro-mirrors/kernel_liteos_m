# rk3568_m UART driver ICUnit test module.

import("//kernel/liteos_m/liteos.gni")

static_library("test_uart") {
  sources = [
    "It_los_uart.c",
    "It_los_uart_001.c",
    "It_los_uart_002.c",
    "It_los_uart_003.c",
    "It_los_uart_004.c",
    "It_los_uart_005.c",
  ]

  include_dirs = [
    # board driver headers for uart_drv.h and uart_board_cfg.h
    "//kernel/liteos_m/targets/rk3568_m/liteos_m/board/include",
  ]

  configs += [ "$LITEOSTOPDIR/testsuites:include" ]
}
