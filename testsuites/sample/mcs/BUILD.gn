# mcs 框架用例库（2026-11-09 目录重组，从核侧）：
#   mica/     init(预留) framework(预留) tty umt rpc
#   service/  np pfs system(Svc/ApiSys/StressSvc)
#   rpmsg/    预留（协议本身用例）
#   combo/    跨服务组合
# 依赖：mica 服务框架（rpc/np/svc 域需主核被动服务配合）

import("//kernel/liteos_m/liteos.gni")

kernel_module("test_mcs") {
  sources = [
    # 总入口 + stress 聚合（阶段 A 保留串行链；阶段 B 由模块数组调度接管）
    # 域聚合
    # 模块注册（阶段 B 调度器的二级数组表）
    # 测试调度服务（独立 rpmsg-mcs-test 端点，host 命令驱动）
    "mcs_test_service.c",
    # 模块注册文件（各域目录手工维护：加用例=extern+数组行各一行）
    "mica/tty/it_mcs_tty.c",
    "mica/umt/it_mcs_umt.c",
    "mica/rpc/it_mcs_rpc.c",
    "service/np/it_mcs_np.c",
