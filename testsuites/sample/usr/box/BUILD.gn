import("//kernel/liteos_m/liteos.gni")

# UTS usr-world BOX test suite (testsuites/sample/usr/box): the cases run
# in boxA USER mode through the shared iCunit copy, invoked by the box test
# entry (usr_demo/tboxA/boxA_test_main.c).
#
# source_set on purpose (NOT static_library): the box section selectors
# (boxes.ld) match objects by FILE NAME on the link line - archive members
# pulled on symbol demand would miss the *boxA*.o routing rules (the
# boxes.ld header documents this). Hence every source file here must carry
# "boxA" in its name.
source_set("test_box_usr") {
  sources = [
    "It_los_boxA_usr.c",
    "It_los_boxA_usr_001.c",
    "It_los_boxA_usr_002.c",
    "It_los_boxA_usr_003.c",
    "It_los_boxA_usr_004.c",
    "It_los_boxA_usr_005.c",
    "It_los_boxA_usr_006.c",
    "It_los_boxA_usr_007.c",
    # Memory cases: one per file, all under mem/, named like the functional
    # BOX usr cases (It_los_boxA_usr_*). Shared helpers are declared in
    # mem/It_los_boxA_usr_mem_util.h and DEFINED ONCE in the matching .c.
    # File names keep "boxA": boxes.ld routes objects into the boxA slot by
    # file name, and a GN object is "<target>.<source>.o" regardless of
    # subdirectory.
    "mem/It_los_boxA_usr_mem_util.c",
    "mem/It_los_boxA_usr_mem_001.c",
    "mem/It_los_boxA_usr_mem_002.c",
    "mem/It_los_boxA_usr_mem_003.c",
    "mem/It_los_boxA_usr_mem_004.c",
    "mem/It_los_boxA_usr_mem_005.c",
    "mem/It_los_boxA_usr_mem_006.c",
    "mem/It_los_boxA_usr_mem_007.c",
    "mem/It_los_boxA_usr_mem_008.c",
    "mem/It_los_boxA_usr_mem_c001.c",
    "mem/It_los_boxA_usr_mem_c006.c",
    "mem/It_los_boxA_usr_mem_e001.c",
    "mem/It_los_boxA_usr_mem_f002.c",
    "mem/It_los_boxA_usr_mem_f003.c",
    "mem/It_los_boxA_usr_mem_tsk_001.c",
    "mem/It_los_boxA_usr_mem_tsk_002.c",
    "mem/It_los_boxA_usr_mem_tsk_003.c",
    "mem/It_los_boxA_usr_mem_tsk_004.c",
    "mem/It_los_boxA_usr_mem_tsk_005.c",
    "mem/It_los_boxA_usr_mem_tsk_006.c",
    "mem/It_los_boxA_usr_mem_tsk_007.c",
    "mem/It_los_boxA_usr_mem_tsk_008.c",
    "mem/It_los_boxA_usr_mem_tsk_009.c",
    "mem/It_los_boxA_usr_mem_tsk_010.c",
  ]

  # Raw include dir, NOT the testsuites ":include" config: that config
  # chains the kernel rename root (box_syscalls - LOS_xxx -> SYS_LOS_xxx).
  # usr test TUs must call the PLAIN names so they link the COMMON_TEXT
  # usr wrappers / syscall veneers; the rename would bind kernel-flash
  # SYS_ code instead (user-mode entry faults). The compile-time self
  # check in the case files (#error on the LOS_TaskCreate macro) guards
  # this route.
  include_dirs = [ "$LITEOSTOPDIR/testsuites/include" ]

  # usr-world include root: "syscalls.h" resolves to the usr prototypes
  # (plain LOS_xxx + the #undef guard), and boxes_conf.h/boxes_res_conf.h
  # reach the case files through osTest.h if ever needed.
  configs += [ "//kernel/liteos_m/targets/stm32f407vet6/liteos_m/box/usr_demo:public" ]

  # Section-routing force-include and ABI flags: any LITE_OS_SEC_* object
  # sneaking in must land in the box sections, and the VFPv4/softfp codegen
  # tag must match the rest of the image.
  cflags = [
    "-include",
    rebase_path("//kernel/liteos_m/targets/stm32f407vet6/liteos_m/board/include/los_builddef_target.h"),
    "-mfpu=fpv4-sp-d16",
    "-mfloat-abi=softfp",
  ]
}
