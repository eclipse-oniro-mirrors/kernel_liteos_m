import("//kernel/liteos_m/liteos.gni")

# boxB usr-world test suite (testsuites/sample/usr/boxB): the cases run in
# boxB USER mode through the shared iCunit copy, invoked by the boxB test
# entry (usr_demo/tboxB/boxB_test_main.c).
#
# source_set on purpose (NOT static_library): the box section selectors
# (boxes.ld) match objects by FILE NAME on the link line - archive members
# pulled on symbol demand would miss the *boxB*.o routing rules. Hence every
# source file here must carry "boxB" in its name.
source_set("test_boxB_usr") {
  sources = [
    "It_los_boxB_usr.c",
    "It_los_boxB_usr_001.c",
    "It_los_boxB_usr_002.c",
    "It_los_boxB_usr_003.c",
    "It_los_boxB_usr_004.c",
    "It_los_boxB_usr_005.c",
    "It_los_boxB_usr_util.c",
  ]

  # Raw include dir, NOT the testsuites ":include" config: that config chains
  # the kernel rename root (LOS_xxx -> SYS_LOS_xxx). usr test TUs must call the
  # PLAIN names so they link the COMMON_TEXT user wrappers; the rename would
  # bind kernel-flash SYS_ code instead (user-mode entry faults). The
  # compile-time self check in the case files (#error on the LOS_MemAlloc
  # macro) guards this route.
  include_dirs = [ "$LITEOSTOPDIR/testsuites/include" ]

  # usr-world include root: "syscalls.h" resolves to the usr prototypes, and
  # boxes_conf.h / boxes_res_conf.h reach the case files through osTest.h.
  configs += [ "//kernel/liteos_m/targets/stm32f407vet6/liteos_m/box/usr_demo:public" ]

  # Section-routing force-include and ABI flags: any LITE_OS_SEC_* object
  # sneaking in must land in the box sections, and the VFPv4/softfp codegen
  # tag must match the rest of the image.
  cflags = [
    "-include",
    rebase_path("//kernel/liteos_m/targets/stm32f407vet6/liteos_m/board/include/los_builddef_target.h"),
    "-mfpu=fpv4-sp-d16",
    "-mfloat-abi=softfp",
  ]
}
