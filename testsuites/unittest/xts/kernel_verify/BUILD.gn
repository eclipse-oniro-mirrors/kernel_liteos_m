import("//kernel/liteos_m/liteos.gni")

# Case attribution: kernel layer (same pattern as xts/cmsis defines) --
# displayed as ItLostestKernelVerify-TEST_LOS-TEST_MISC-TEST_LEVEL0.
# NOTE: the defines list must stay shared by ALL sources of this target
_kv_defines = [
  "XTS_CASE_LAYER=TEST_LOS",
  "XTS_CASE_MODULE=TEST_MISC",
  "XTS_CASE_LEVEL=TEST_LEVEL0",
]

static_library("kernel_verify_test") {
  defines = _kv_defines

  sources = [
    "kernel_verify.c",
    "kernel_verify_xts_test.c",
  ]

  # headers; kernel_verify.c / kernel_verify_xts_test.c are self-contained
  # (kernel_verify.h -> kernel_verify_layout.h carries no kernel includes).
  include_dirs = [
    ".",
    "$LITEOSTOPDIR/testsuites/include",
    "$LITEOSTOPDIR/testsuites/unittest/xts",
    "$LITEOSTOPDIR/kernel/base/include",
    "$LITEOSTOPDIR/kernel/include",
  ]
  configs += [ "$LITEOSTOPDIR/testsuites:no_test_coverage" ]
}
