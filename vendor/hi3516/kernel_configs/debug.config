# Cortex-A7 单态最小内核
# 砍掉 shell/FS/Net/IPC 先不要,先让内核能跑
# (POSIX/VFS/CPUP/SIGNAL/CMSIS 全删,只留 task/sched/tick/interrupt/MMU + IPC + swtmr)

# === 编译器 ===
LOSCFG_COMPILER_CLANG_LLVM=y

# === 平台 + 架构 ===
LOSCFG_PLATFORM_HI3516DV300=y
LOSCFG_ARCH_CORTEX_A7=y
LOSCFG_ARCH_ARM_AARCH32=y
LOSCFG_ARCH_FPU_DISABLE=y
# LOSCFG_ARCH_FPU is not set
# LOSCFG_ARCH_FPU_VFP_V4 is not set
LOSCFG_SOC_COMPANY="hisilicon"

# === 任务调度(必须有)===
LOSCFG_BASE_CORE_TSK_MONITOR=y
LOSCFG_BASE_CORE_TSK_LIMIT=24
LOSCFG_BASE_CORE_TSK_MIN_STACK_SIZE=1024
LOSCFG_BASE_CORE_TSK_IDLE_STACK_SIZE=2048
LOSCFG_BASE_CORE_TSK_DEFAULT_STACK_SIZE=4096

# === 中断 GICv2 ===
# 注意:符号名是 LOSCFG_ARM_GIC_V2(无 H)。旧写法 LOSCFG_ARCH_GIC_V2 是失效符号
# (会被 Kconfig 静默忽略);实际靠下面 LOSCFG_ARCH_CORTEX_A7 -> select ARM_GIC_V2
# 生效,此处显式声明以自文档化。
LOSCFG_ARM_GIC_V2=y
LOSCFG_HWI_PRE_POST_PROCESS=y

# === IPC(跟 ws63 靠齐:开 SWTMR,测试套件 task/queue/event 用例依赖 LOS_Swtmr*)===
LOSCFG_BASE_CORE_SWTMR=y
LOSCFG_KERNEL_TICK_PERIODIC=y
LOSCFG_BASE_IPC_EVENT=y
LOSCFG_BASE_IPC_SEM=y
LOSCFG_BASE_IPC_SEM_LIMIT=48
LOSCFG_BASE_IPC_MUX=y
LOSCFG_BASE_IPC_MUX_LIMIT=24
LOSCFG_BASE_IPC_QUEUE=y
LOSCFG_BASE_IPC_QUEUE_LIMIT=24

# === 关闭非最小特性 ===
LOSCFG_KERNEL_EXTKERNEL=y
# LOSCFG_KERNEL_CPUP is not set
# LOSCFG_BASE_CORE_CPUP is not set
# LOSCFG_CPUP_INCLUDE_IRQ is not set
# LOSCFG_KERNEL_SIGNAL is not set
# LOSCFG_KERNEL_BACKTRACE is not set
LOSCFG_POSIX_API=y
# pipe 实现架在 VFS 上(open/read/write),无 FS 的板子必须关
# LOSCFG_POSIX_PIPE_API is not set
# LOSCFG_FS_VFS is not set
# LOSCFG_KAL_CMSIS is not set
# LOSCFG_LIBC_NEWLIB is not set
# SCHED_LATENCY 是 V7M 专用(PendSV defer),A7 不该开(Kconfig depends ARM_V7M 没排除我们)
# LOSCFG_SCHED_LATENCY is not set

# === libc:不开 musl(会破坏 PRINTK/vsnprintf 异常路径,locale 未初始化 data abort)。
# 测试的 stdint/intptr_t 靠 osTest.h/xts_test.h 加的 #include <stdint.h>(newlib/gcc 自带)。===
# LOSCFG_LIBC_MUSL is not set

# === 测试套件 ===
# 开 KERNEL_TEST → select TEST → module_switch true → test_init 编译(LosAppInit 有定义)。
# 但 testsuites group("testsuites") deps 全拉 cmsis/io/xts(我们特性没开编不过),
# 故 board BUILD.gn 不 deps group,直接 deps test_init + test_task,并改 group 去掉编不过的。
LOSCFG_KERNEL_TEST=y
LOSCFG_KERNEL_TEST_FULL=y

LOSCFG_KERNEL_SMP=y
LOSCFG_KERNEL_SMP_CORE_NUM=2
LOSCFG_KERNEL_SMP_GC_SWTMR=y
LOSCFG_BASE_IPC_RWSEM=y
