LOSCFG_PLATFORM_HI3322=y
# Double-precision FPU: D extension + ilp32d ABI (device/board/hihope/hi3322/
# liteos_m/config.gni sets -march=rv32imfdc -mabi=ilp32d); the kernel
# saves/restores FP registers as 64-bit (fld/fsd, liteos_m soc_common.h).
LOSCFG_ARCH_FPU_DOUBLE=y
LOSCFG_COMPILER_CLANG_LLVM=y
LOSCFG_ARCH_TIMER_VENDOR=y
LOSCFG_DW_APB_TIMER=y
# DW_APB_TIMER depends on !KERNEL_TICKLESS_GLOBAL; make the tick mode
# explicit instead of relying on the choice default (TICKLESS_GLOBAL).
LOSCFG_KERNEL_TICK_PERIODIC=y
LOSCFG_HWI_PRIO_LIMIT=7
# LOSCFG_COMPILE_LTO is not set
LOSCFG_KERNEL_BACKTRACE=y
LOSCFG_KERNEL_CPUP=y
# LOSCFG_KERNEL_TRACE is not set
LOSCFG_LIBC_MUSL=y
# LOSCFG_CPUP_INCLUDE_IRQ is not set
LOSCFG_PLATFORM_EXC=y
LOSCFG_SHELL_EXCINFO_DUMP=y
LOSCFG_ARCH_INTERRUPT_PREEMPTION=y
LOSCFG_HWI_PRE_POST_PROCESS=y
LOSCFG_BASE_CORE_TSK_LIMIT=28
LOSCFG_BASE_CORE_TSK_MIN_STACK_SIZE=1024
LOSCFG_BASE_CORE_TSK_IDLE_STACK_SIZE=2048
LOSCFG_BASE_IPC_SEM=y
LOSCFG_BASE_IPC_SEM_LIMIT=32
LOSCFG_BASE_IPC_MUX=y
LOSCFG_BASE_IPC_MUX_LIMIT=60
LOSCFG_BASE_IPC_QUEUE=y
LOSCFG_BASE_IPC_QUEUE_LIMIT=30

LOSCFG_KERNEL_MEM_BESTFIT=y
LOSCFG_MEM_DEBUG=y
LOSCFG_BASE_MEM_NODE_INTEGRITY_CHECK=y
LOSCFG_BASE_MEM_NODE_SIZE_CHECK=y
LOSCFG_MEM_MUL_MODULE=y
LOSCFG_KERNEL_MEM_SLAB_EXTENTION=y
LOSCFG_MEM_MUL_POOL_ALLOC=y
LOSCFG_QUEUE_STATIC_ALLOCATION=y
LOSCFG_KERNEL_PM=y
LOSCFG_SHELL=y

# littlefs over SPI NOR (GD25LQ128E via SFC, 3 volumes /boot /system /user,
# see morpheus/NOR_PORTING_PLAN.md). FS_LITTLEFS depends on FS_VFS and
# selects SUPPORT_LITTLEFS (kernel/liteos_m/fs/Kconfig); LFS_MAX_MOUNT_SIZE
# default is 3.
LOSCFG_FS_LITTLEFS=y

# yaffs2 OH-VFS adapter + libc symbol floor for the CLOSED prebuilt
# libyaffs2.orig.a (NAND backend, see YAFFS2_BINARY_LIB_PORTING_PLAN.md).
# FS_YAFFS depends on FS_VFS (fs/yaffs2/Kconfig); the module is off for
# boards that do not link the closed archive (its printf/dprintf shims
# collide with board libc shims, e.g. qemu arm_mps2_an386 dprintf.c).
LOSCFG_FS_YAFFS=y
LOSCFG_FS_VFS=y
LOSCFG_BASE_CORE_SWTMR_LIMIT=16
