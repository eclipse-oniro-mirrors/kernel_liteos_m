LOSCFG_PLATFORM_QEMU_RISCV32_VIRT=y
LOSCFG_ARCH_FPU_DISABLE=y
LOSCFG_POSIX_API=n
LOSCFG_KERNEL_BACKTRACE=y
LOSCFG_KERNEL_CPUP=y
LOSCFG_KERNEL_PM=y
#LOSCFG_FS_FAT=y
#LOSCFG_FS_LITTLEFS=y
#LOSCFG_NET_LWIP=y
LOSCFG_SHELL=y
LOSCFG_BASE_CORE_TICK_PER_SECOND=100
LOSCFG_BASE_CORE_TSK_LIMIT=24
LOSCFG_BASE_CORE_TSK_IDLE_STACK_SIZE=1280
LOSCFG_BASE_CORE_TSK_DEFAULT_STACK_SIZE=4096
LOSCFG_BASE_CORE_TSK_MIN_STACK_SIZE=1280
LOSCFG_BASE_CORE_TSK_SWTMR_STACK_SIZE=2048
LOSCFG_SHELL_STACK_SIZE=8192
LOSCFG_BASE_CORE_SWTMR_LIMIT=48
LOSCFG_BASE_IPC_SEM_LIMIT=48
LOSCFG_BASE_IPC_MUX_LIMIT=50
LOSCFG_BASE_IPC_QUEUE_LIMIT=24
#LOSCFG_DRIVERS_HDF=y
LOSCFG_LIBC_NEWLIB=y
#LOSCFG_LIBC_NEWLIB_FS=y
LOSCFG_KERNEL_SIGNAL=n
LOSCFG_USING_BOARD_RESET_VECTOR=n
