#
# RK3568 AMP (liteos_m on CPU3) debug kernel config.
#
LOSCFG_PLATFORM_RK3568_M=y
# LOSCFG_COMPILER_GCC is not set
LOSCFG_COMPILER_CLANG_LLVM=y
# LOSCFG_COMPILE_LTO is not set

# --- interrupt: GICv3 (selected by PLATFORM_RK3568_M) ---
LOSCFG_HWI_PRIO_LIMIT=32
# LOSCFG_ARCH_INTERRUPT_PREEMPTION is not set
# LOSCFG_HWI_PRE_POST_PROCESS is not set
# LOSCFG_CPUP_INCLUDE_IRQ is not set

# --- timer: generic timer (arch default) ---
# LOSCFG_ARCH_TIMER_VENDOR is not set
# LOSCFG_ARCH_INTERRUPT_VENDOR is not set

# --- memory ---
LOSCFG_KERNEL_MEM_BESTFIT=y
LOSCFG_MEM_TASK_STAT=y
LOSCFG_MEM_MUL_POOL_ALLOC=y
LOSCFG_MEM_MUL_MODULE=y

# --- kernel ---
LOSCFG_KERNEL_BACKTRACE=y
LOSCFG_KERNEL_CPUP=y
LOSCFG_PLATFORM_EXC=y
LOSCFG_KERNEL_TICK_PERIODIC=y
# Q4: 1 ms tick - UART driver timeout granularity (Modbus-RTU plan V0.17).
# NOTE: the tick is SGI 9 kicked by the master mcs_km hrtimer - the master
# side must be configured for the same 1 ms period.
LOSCFG_BASE_CORE_TICK_PER_SECOND=1000
LOSCFG_BASE_CORE_TSK_LIMIT=28
LOSCFG_BASE_CORE_TSK_MIN_STACK_SIZE=1024
LOSCFG_BASE_CORE_TSK_IDLE_STACK_SIZE=2048
LOSCFG_BASE_CORE_TSK_SWTMR_STACK_SIZE=4096
LOSCFG_BASE_IPC_SEM_LIMIT=32
LOSCFG_BASE_IPC_MUX_LIMIT=60
LOSCFG_MUTEX_WAITMODE_PRIO=y
LOSCFG_BASE_IPC_QUEUE_LIMIT=30

# --- libc / compat ---
LOSCFG_LIBC_MUSL=y
LOSCFG_FS_VFS=y

# --- shell ---
LOSCFG_SHELL=y
LOSCFG_SHELL_DMESG=y
LOSCFG_SHELL_EXCINFO_DUMP=y

# --- MCS hybrid deployment (M4): select chain MCS -> RK3568_OPENAMP ---
LOSCFG_MCS=y

# NIC verification build: GMAC data-plane + three-mode self-test task.
# Off for the UART verification bench (master-side mcs_net.ko handover
# not present on this board); re-enable together with the NIC work.
# LOSCFG_MCS_NET=y  (off: duplicate symbol with SoC driver net_dwmac.c from !1221; also spams UART with tx EAGAIN when GMAC1 link is down)

# --- Real-time CAN data plane (CAN1; CAN2 profile reserved) ---
LOSCFG_MCS_CAN=y

# --- UART driver (Modbus-RTU oriented, board/uart.c + uart_drv.h) ---
LOSCFG_RK3568_UART=y
LOSCFG_MCS_RPC=y

# --- interface test suites (testsuites/sample/mcs): KERNEL_TEST selects
# TEST; NET demo off in main.c under LOSCFG_TEST (see main.c) ---
LOSCFG_KERNEL_TEST=y
LOSCFG_BASE_CORE_SWTMR_LIMIT=48
