#
# RK3568 AMP (liteos_m on CPU3) debug kernel config.
#
LOSCFG_PLATFORM_RK3568_M=y
# LOSCFG_COMPILER_GCC is not set
LOSCFG_COMPILER_CLANG_LLVM=y
# LOSCFG_COMPILE_LTO is not set

# --- interrupt: GICv3 (selected by PLATFORM_RK3568_M) ---
LOSCFG_HWI_PRIO_LIMIT=32
# LOSCFG_ARCH_INTERRUPT_PREEMPTION is not set
# LOSCFG_HWI_PRE_POST_PROCESS is not set
# LOSCFG_CPUP_INCLUDE_IRQ is not set

# --- timer: generic timer (arch default) ---
# LOSCFG_ARCH_TIMER_VENDOR is not set
# LOSCFG_ARCH_INTERRUPT_VENDOR is not set
# Discrete tick time base: the scheduler-start origin phase makes a
# continuous source lag the ISR count by one at every tick wake.

# --- memory ---
LOSCFG_KERNEL_MEM_BESTFIT=y
LOSCFG_MEM_TASK_STAT=y
LOSCFG_MEM_MUL_POOL_ALLOC=y
LOSCFG_MEM_MUL_MODULE=y

# --- kernel ---
LOSCFG_KERNEL_BACKTRACE=y
# CPUP compiled out in the TEST image only (AMP tick makes the tick-sampled
# numbers non-representative); the product image keeps LOSCFG_KERNEL_CPUP=y.
# LOSCFG_KERNEL_CPUP is not set
LOSCFG_PLATFORM_EXC=y
LOSCFG_KERNEL_TICK_PERIODIC=y
# 1 ms tick (UART driver timeout granularity); the tick is SGI 9 kicked by
# the master mcs_km hrtimer - the master side must use the same period.
LOSCFG_BASE_CORE_TICK_PER_SECOND=1000
LOSCFG_BASE_CORE_TSK_LIMIT=48
LOSCFG_BASE_CORE_TSK_MIN_STACK_SIZE=1024
LOSCFG_BASE_CORE_TSK_IDLE_STACK_SIZE=2048
LOSCFG_BASE_CORE_TSK_SWTMR_STACK_SIZE=4096
LOSCFG_BASE_IPC_SEM_LIMIT=64
LOSCFG_BASE_IPC_MUX_LIMIT=60
LOSCFG_MUTEX_WAITMODE_PRIO=y
LOSCFG_BASE_IPC_QUEUE_LIMIT=30
# rwsem enabled for the full-suite bench (default limit 6 is tight).
LOSCFG_BASE_IPC_RWSEM=y
LOSCFG_BASE_IPC_RWSEM_LIMIT=15

# --- libc / compat ---
LOSCFG_LIBC_MUSL=y
LOSCFG_FS_VFS=y

# --- shell ---
LOSCFG_SHELL=y
LOSCFG_SHELL_DMESG=y
LOSCFG_SHELL_EXCINFO_DUMP=y

# --- MCS hybrid deployment (M4): select chain MCS -> RK3568_OPENAMP ---
LOSCFG_MCS=y
# NIC self-test task off for the UART bench (no master-side mcs_net.ko
# handover on this board); re-enable together with the NIC work.
# LOSCFG_MCS_NET=y

# --- UART driver (Modbus-RTU oriented, board/uart.c + uart_drv.h) ---
LOSCFG_RK3568_UART=y

# ---- test suite (rk3568_m_testsuits variant only; the product config
#      stays test-free - without these lines the product image is
#      byte-identical to a tree without the testsuites changes) ----
LOSCFG_KERNEL_TEST=y
LOSCFG_QUEUE_STATIC_ALLOCATION=y
LOSCFG_BASE_CORE_TSK_DEFAULT_STACK_SIZE=4096

# Functional test adaptations for this bench (feature macros instead of
# a board macro): UART driver suite registration, AMP-slave shared
# GIC/UART framework adaptations, asynchronously delivered software
# triggers, folded HWI priority granularity, tick-phase-lag case skips.
LOSCFG_TEST_UART_DRV=y
LOSCFG_TEST_AMP_SLAVE=y
LOSCFG_TEST_HWI_TRIG_ASYNC=y
LOSCFG_TEST_HWI_PRIO_FOLDED=y
LOSCFG_TEST_TICK_PHASE_LAG=y

# CMSIS layer compiled out in the TEST image only; the product image
# keeps it (KAL_CMSIS default y).
# LOSCFG_KAL_CMSIS is not set

# Full-suite bench: FULL mode on (aggregate-gated extra cases register
# as well); CPUP off and CMSIS off as noted above; rwsem on.
LOSCFG_KERNEL_TEST_FULL=y

# POSIX API kept enabled (libc/musl depends on it); the POSIX test
# *suites* are excluded at the BUILD.gn level + osTest.h macro level
