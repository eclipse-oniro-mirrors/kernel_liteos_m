#
# RK3588 AMP (liteos_m on CPU7) full-suite bench config (testsuits product).
# Base: rk3588_m product debug config + full-suite test items, mirroring
# the validated rk3568_m_testsuits form (minimal first version: the
# TEST_* adaptation macros are NOT enabled yet - add per board results).
#
LOSCFG_PLATFORM_RK3588_M=y
# LOSCFG_COMPILER_GCC is not set
LOSCFG_COMPILER_CLANG_LLVM=y
# LOSCFG_COMPILE_LTO is not set

# --- interrupt: GICv3 (selected by PLATFORM_RK3588_M) ---
LOSCFG_HWI_PRIO_LIMIT=32
# LOSCFG_ARCH_INTERRUPT_PREEMPTION is not set
# LOSCFG_HWI_PRE_POST_PROCESS is not set
# LOSCFG_CPUP_INCLUDE_IRQ is not set

# --- timer: generic timer (arch default) ---
# LOSCFG_ARCH_TIMER_VENDOR is not set
# LOSCFG_ARCH_INTERRUPT_VENDOR is not set

# --- memory ---
LOSCFG_KERNEL_MEM_BESTFIT=y
LOSCFG_MEM_TASK_STAT=y
LOSCFG_MEM_MUL_POOL_ALLOC=y
LOSCFG_MEM_MUL_MODULE=y

# --- kernel ---
LOSCFG_KERNEL_BACKTRACE=y
# LOSCFG_KERNEL_CPUP is not set (r6: the CPUP guard swtmr (period 1000 ticks
# = 1s) is the only real software timer in the system; the slave crashed at
# its FIRST expiry (tick 1000) in every round. Disabled as the discriminator.)
LOSCFG_PLATFORM_EXC=y
LOSCFG_KERNEL_TICK_PERIODIC=y
LOSCFG_BASE_CORE_TICK_PER_SECOND=1000
LOSCFG_BASE_CORE_TSK_LIMIT=48
LOSCFG_BASE_CORE_TSK_DEFAULT_STACK_SIZE=4096
LOSCFG_BASE_CORE_TSK_MIN_STACK_SIZE=1024
LOSCFG_BASE_CORE_TSK_IDLE_STACK_SIZE=2048
LOSCFG_BASE_CORE_TSK_SWTMR_STACK_SIZE=4096
# swtmr pool limit (Kconfig authority; was hardcoded in the board
# target_config.h and clashed with the Kconfig-generated config.h).
LOSCFG_BASE_CORE_SWTMR_LIMIT=48
LOSCFG_BASE_IPC_SEM_LIMIT=64
LOSCFG_BASE_IPC_MUX_LIMIT=60
LOSCFG_MUTEX_WAITMODE_PRIO=y
LOSCFG_BASE_IPC_QUEUE_LIMIT=30
LOSCFG_QUEUE_STATIC_ALLOCATION=y
# rwsem enabled for the full-suite bench (default limit 6 is tight).
LOSCFG_BASE_IPC_RWSEM=y
LOSCFG_BASE_IPC_RWSEM_LIMIT=15

# --- libc / compat ---
LOSCFG_LIBC_MUSL=y
LOSCFG_FS_VFS=y

# --- shell ---
LOSCFG_SHELL=y
LOSCFG_SHELL_DMESG=y
LOSCFG_SHELL_EXCINFO_DUMP=y

# --- MCS hybrid deployment: select chain MCS -> RK3588_OPENAMP ---
LOSCFG_MCS=y

# --- MCS data planes OFF in the bench form (same as the validated
#      rk3568_m_testsuits product): their board-level self-test tasks
#      run concurrently with the test framework. ---
# LOSCFG_MCS_NET is not set
# LOSCFG_MCS_CAN is not set

# --- UART driver (Modbus-RTU oriented, board/uart.c + uart_drv.h) ---
LOSCFG_RK3588_UART=y

# --- full-suite bench (rk3588_m_testsuits variant only; the rk3588_m
#      product config stays test-free) ---
LOSCFG_KERNEL_TEST=y
# Full-suite bench: FULL mode on (aggregate-gated extra cases register
# as well).
LOSCFG_KERNEL_TEST_FULL=y
# Suite selection (Kconfig knobs): kernel suites only - the CMSIS/POSIX/
# XTS suites are excluded from the bench form (same as the validated
# rk3568_m_testsuits product).
LOSCFG_TEST_ICUNIT_KERNEL=y
# LOSCFG_TEST_ICUNIT_CMSIS is not set
# LOSCFG_TEST_ICUNIT_POSIX is not set
# LOSCFG_TEST_UNI_POSIX is not set
# LOSCFG_TEST_UNI_XTS is not set
# CMSIS layer compiled out in the TEST image only.
# LOSCFG_KAL_CMSIS is not set
