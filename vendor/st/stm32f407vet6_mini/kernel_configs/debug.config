LOSCFG_PLATFORM_STM32F407VET6=y
LOSCFG_ARCH_CORTEX_M_UNIFIED=y
LOSCFG_MEM_FREE_BY_TASKID=y
LOSCFG_HWI_PRE_POST_PROCESS=y
LOSCFG_HWI_BOTTOM_HALF=y
LOSCFG_BASE_CORE_TICK_PER_SECOND=1000
LOSCFG_BASE_CORE_TSK_LIMIT=24
LOSCFG_BASE_CORE_TSK_MIN_STACK_SIZE=1024
LOSCFG_BASE_CORE_TSK_IDLE_STACK_SIZE=2048
LOSCFG_BASE_CORE_TSK_MONITOR=y
LOSCFG_BASE_CORE_TSK_DEFAULT_STACK_SIZE=2048
LOSCFG_BASE_CORE_SWTMR_LIMIT=48
LOSCFG_BASE_IPC_SEM_LIMIT=48
LOSCFG_BASE_IPC_MUX_LIMIT=24
LOSCFG_BASE_IPC_QUEUE_LIMIT=24
LOSCFG_QUEUE_STATIC_ALLOCATION=y
LOSCFG_CORTEX_M_NVIC=y
LOSCFG_CORTEX_M_SYSTICK=y

# BOX: user-mode isolation (box tasks, dual stack, syscalls)
LOSCFG_BOX=y

# Backtrace: cortex-m stack-scan call chain dump on exceptions
LOSCFG_KERNEL_BACKTRACE=y
LOSCFG_BACKTRACE_TYPE_1=y
