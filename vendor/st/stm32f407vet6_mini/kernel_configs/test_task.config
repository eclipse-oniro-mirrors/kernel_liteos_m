LOSCFG_PLATFORM_STM32F407VET6=y
LOSCFG_ARCH_CORTEX_M_UNIFIED=y
LOSCFG_KERNEL_MEM_BESTFIT=y
LOSCFG_MEM_MUL_POOL=y
LOSCFG_KERNEL_BACKTRACE=y
LOSCFG_HWI_PRE_POST_PROCESS=y
LOSCFG_HWI_BOTTOM_HALF=y
LOSCFG_BASE_CORE_TICK_PER_SECOND=1000
LOSCFG_KERNEL_TICK_PERIODIC=y
LOSCFG_BASE_CORE_TSK_LIMIT=12
LOSCFG_BASE_CORE_TSK_MIN_STACK_SIZE=1024
LOSCFG_BASE_CORE_TSK_IDLE_STACK_SIZE=2048
LOSCFG_BASE_CORE_TSK_MONITOR=y
LOSCFG_BASE_CORE_TSK_DEFAULT_STACK_SIZE=2048
LOSCFG_BASE_CORE_SWTMR_LIMIT=16
LOSCFG_BASE_IPC_SEM_LIMIT=8
LOSCFG_BASE_IPC_MUX_LIMIT=8
LOSCFG_BASE_IPC_QUEUE_LIMIT=8
LOSCFG_BASE_IPC_EVENT_LIMIT=8
LOSCFG_BASE_IPC_CONDVAR=y
LOSCFG_BASE_IPC_CONDVAR_LIMIT=4
LOSCFG_QUEUE_STATIC_ALLOCATION=y
LOSCFG_CORTEX_M_NVIC=y
LOSCFG_CORTEX_M_SYSTICK=y
LOSCFG_BOX=y
LOSCFG_BASE_BOX_MAX_LIMIT=2
LOSCFG_MEM_MUL_MODULE=y
LOSCFG_MEM_MODULE_MAX=32

# Task-only kernel-test fragment (activated with:
#   LITEOS_CONFIG=test_task.config hb build
# liteos.gni picks the fragment file name from that env var; the default
# build keeps using debug.config untouched).
#
# The base block above MUST stay in sync with debug.config: this file is a
# full Kconfig fragment (KCONFIG_ALLCONFIG), not an increment, so any demo
# base change (IPC limits, BOX knobs...) needs mirroring here.
#
# Scope: kernel task suite ONLY.
#   - LOSCFG_TEST_KERNEL_TASK=y keeps libtest_task.a (It_los_task_*.c).
#   - LOSCFG_KERNEL_TEST_FULL=y also registers the FULL-gated cases
#     (ItLosTask039/040/043/053/056/.../116).
#   - every other kernel suite (queue/event/box) and the box user-mode
#     phase are switched off, so nothing else is linked or executed and
#     KERNEL_FLASH only has to hold the task cases.
#   - the entry point (osTest.c) additionally runs only ItSuiteLosTask()
#     while LOS_KERNEL_SCHED_ONLY_TEST is 1 (testsuites/include/osTest.h).
LOSCFG_KERNEL_TEST=y
LOSCFG_TEST_ICUNIT_KERNEL=y
# LOSCFG_TEST_KERNEL_ATOMIC is not set
# LOSCFG_TEST_KERNEL_EVENT is not set
# LOSCFG_TEST_KERNEL_EXC is not set
# LOSCFG_TEST_KERNEL_HWI is not set
# LOSCFG_TEST_KERNEL_MEM is not set
# LOSCFG_TEST_KERNEL_MISC is not set
# LOSCFG_TEST_KERNEL_MUX is not set
# LOSCFG_TEST_KERNEL_QUEUE is not set
# LOSCFG_TEST_KERNEL_RWSEM is not set
# LOSCFG_TEST_KERNEL_SEM is not set
# LOSCFG_TEST_KERNEL_SWTMR is not set
LOSCFG_TEST_KERNEL_TASK=y
# LOSCFG_TEST_KERNEL_TCB_VERIFY is not set
# LOSCFG_TEST_KERNEL_BOX is not set
LOSCFG_TEST_BOX_USR=y
# LOSCFG_TEST_ICUNIT_CMSIS is not set
# LOSCFG_TEST_ICUNIT_POSIX is not set
# LOSCFG_TEST_UNI_POSIX is not set
# LOSCFG_TEST_UNI_XTS is not set
# LOSCFG_KERNEL_TEST_FULL is not set
