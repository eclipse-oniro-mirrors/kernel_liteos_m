LOSCFG_PLATFORM_WS63_M=y
LOSCFG_ARCH_CACHE=y
LOSCFG_KERNEL_MEM_BESTFIT=y
LOSCFG_KERNEL_MEM_SLAB_EXTENTION=y
LOSCFG_MEM_TASK_STAT=y
LOSCFG_MEM_MUL_POOL_ALLOC=y
LOSCFG_MEM_MUL_MODULE=y
LOSCFG_KERNEL_CPUP=y
# LOSCFG_CPUP_INCLUDE_IRQ is not set
LOSCFG_KERNEL_PM=y
LOSCFG_PLATFORM_EXC=y
LOSCFG_KERNEL_LMS=y
LOSCFG_LMS_MAX_RECORD_POOL_NUM=10
LOSCFG_LMS_LOAD_CHECK=y
LOSCFG_LMS_STORE_CHECK=y
# LOSCFG_LMS_CHECK_STRICT is not set
# LOSCFG_LMS_LIBC_FULL_CHECK is not set
LOSCFG_ARCH_INTERRUPT_PREEMPTION=y
LOSCFG_HWI_PRE_POST_PROCESS=y
LOSCFG_KERNEL_TICK_PERIODIC=y
LOSCFG_BASE_CORE_TSK_LIMIT=28
LOSCFG_BASE_CORE_TSK_MIN_STACK_SIZE=1024
LOSCFG_BASE_CORE_TSK_IDLE_STACK_SIZE=2048
LOSCFG_BASE_CORE_TSK_DEFAULT_STACK_SIZE=4096
LOSCFG_BASE_IPC_SEM_LIMIT=32
LOSCFG_BASE_IPC_MUX_LIMIT=60
LOSCFG_MUTEX_WAITMODE_PRIO=y
LOSCFG_BASE_IPC_QUEUE_LIMIT=30
LOSCFG_QUEUE_STATIC_ALLOCATION=y
LOSCFG_BASE_IPC_RWSEM=y
LOSCFG_FS_VFS=y
LOSCFG_MEM_DEBUG=y
LOSCFG_MEM_LEAKCHECK=y
LOSCFG_BASE_MEM_NODE_INTEGRITY_CHECK=y
LOSCFG_BASE_MEM_NODE_SIZE_CHECK=y
LOSCFG_SHELL_EXCINFO_DUMP=y
LOSCFG_SHELL=y
LOSCFG_SHELL_DMESG=y
LOSCFG_DW_APB_TIMER=y
LOSCFG_KERNEL_TEST=y
LOSCFG_KERNEL_TEST_FULL=y
LOSCFG_BASE_CORE_SWTMR_LIMIT=16

# testsuites 按目录裁剪（menu "Test directory selection"，default y）
LOSCFG_TEST_ICUNIT_KERNEL=y
LOSCFG_TEST_ICUNIT_CMSIS=y
LOSCFG_TEST_ICUNIT_POSIX=y
LOSCFG_TEST_UNI_POSIX=y
LOSCFG_TEST_UNI_XTS=y
